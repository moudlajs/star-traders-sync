# star-traders-sync - example configuration
#
# Install to: ~/.config/star-traders-sync/config
# install.sh copies this file there if no config exists. It never overwrites
# one.
#
# Every key, its default, what must match across machines, and the rules the
# tool enforces: docs/configuration.md
#
# Format: KEY=value, one per line. The file is PARSED, never sourced, so no
# shell syntax, no quotes, no expansion. An unknown key is a hard error.


# --- Required -------------------------------------------------------------

# Tailscale node name of the machine hosting the hub. See: tailscale status
HUB_HOST=hub-tailnet-name

# SSH account ON THE HUB. Ignored when running on the hub itself.
HUB_USER=youruser

# The hub directory, ON THE HUB HOST. Must be absolute.
HUB_PATH=/Users/youruser/star-traders-sync-hub

# The game's save directory on THIS machine. Verify it rather than trusting
# this value - see "Finding your save directory" in docs/design.md.
LOCAL_SAVE_PATH=~/Library/StarTradersFrontiers

# From appmanifest_<id>.acf. 335620 = Star Traders: Frontiers.
STEAM_APPID=335620

# Name for pgrep -x. push and pull refuse while it is running.
GAME_PROCESS_NAME=StarTradersFrontiers

# Mount point that must be present for sts backup. Required even if you
# never run one.
BACKUP_VOLUME=/Volumes/YourDisk

# Where timestamped backups go. Must live under BACKUP_VOLUME.
BACKUP_DEST=/Volumes/YourDisk/Backups/star-traders-sync


# --- Optional, shown with their defaults ----------------------------------

# Files never transferred, space separated. Must be the same on both
# machines - the fingerprint manifests are built with these names excluded.
SYNC_EXCLUDE=data.db steam_autocloud.vdf

# Seconds sts play waits for the game to appear before giving up on it.
GAME_START_TIMEOUT=90

SSH_PORT=22
SSH_CONNECT_TIMEOUT=10

# Extra ssh options. BatchMode, ConnectTimeout and StrictHostKeyChecking are
# always set by sts and cannot be overridden here.
SSH_EXTRA_OPTS=

# 1 = try MagicDNS, fall back to the tailnet IP. 0 = always use the IP.
PREFER_MAGICDNS=1

# Snapshots kept per side, under <target>/../star-traders-sync-snapshots/.
SNAPSHOT_KEEP=10

# When this machine's own crashed hub lock is cleared. Another machine's lock
# is never cleared automatically, at any age.
LOCK_TTL_SECONDS=3600

# Warn when the hub's clock differs by more than this many seconds.
CLOCK_SKEW_TOLERANCE=300

# Timestamped backup directories to keep. 0 disables pruning.
BACKUP_KEEP=30

# Seconds to wait for BACKUP_VOLUME to appear. The launchd installer raises
# this to 180; 0 is right for an interactive run.
BACKUP_MOUNT_WAIT=0

# ~/Library/Logs/star-traders-sync/star-traders-sync.log
LOG_MAX_BYTES=5242880
LOG_KEEP=3

# DEBUG, INFO, WARN or ERROR. --verbose mirrors to stderr regardless.
LOG_LEVEL=INFO
