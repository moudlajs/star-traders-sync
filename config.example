# star-traders-sync - every config key, one line each.
#
# Install to: ~/.config/star-traders-sync/config
# The full reference, with defaults and which keys must match across
# machines, is docs/configuration.md. install.sh writes a short working
# config for you; copy lines from here only to change an optional key.
#
# KEY=value only. The file is parsed, never sourced: no shell syntax.


# --- Required -------------------------------------------------------------

# Tailscale node name of the hub machine.
HUB_HOST=your-hub-tailnet-name

# Account ON THE HUB that ssh logs in as.
HUB_USER=youruser

# Absolute path of the hub directory on the hub host.
HUB_PATH=/Users/youruser/star-traders-sync-hub

# The game's save directory on this machine.
LOCAL_SAVE_PATH=~/Library/StarTradersFrontiers

# Star Traders: Frontiers on Steam, and its process name.
STEAM_APPID=335620
GAME_PROCESS_NAME=StarTradersFrontiers

# Backup disk and destination. Used on the hub host only (#53).
BACKUP_VOLUME=/Volumes/YourDisk
BACKUP_DEST=/Volumes/YourDisk/Backups/star-traders-sync


# --- Optional -------------------------------------------------------------

# File names never transferred. Keep this line; see docs/configuration.md.
SYNC_EXCLUDE=data.db steam_autocloud.vdf

GAME_START_TIMEOUT=90

SSH_PORT=22
SSH_CONNECT_TIMEOUT=10
SSH_EXTRA_OPTS=
PREFER_MAGICDNS=1

SNAPSHOT_KEEP=10
LOCK_TTL_SECONDS=3600
CLOCK_SKEW_TOLERANCE=300

BACKUP_KEEP=30
BACKUP_MOUNT_WAIT=0

LOG_MAX_BYTES=5242880
LOG_KEEP=3
LOG_LEVEL=INFO
