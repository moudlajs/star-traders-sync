#!/bin/bash
#
# star-traders-sync - sync Star Traders: Frontiers saves between Macs over
# Tailscale, through a hub directory that is the single source of truth.
#
# One script, identical on both machines. Every difference lives in
# ~/.config/star-traders-sync/config.
#
# Plain bash 3.2. No bash 4 features: no associative arrays, no ${x^^},
# no mapfile, no <<<.

set -Eeuo pipefail

readonly STS_VERSION="1.1.0"
readonly PROG="star-traders-sync"

# --------------------------------------------------------------------------
# Exit codes. Every one of these is documented in --help and in the README
# troubleshooting table. Nothing exits non-zero without one of these.
# --------------------------------------------------------------------------
readonly EX_OK=0
readonly EX_USAGE=2

readonly EX_CONFIG_MISSING=10      # config absent or unreadable
readonly EX_CONFIG_MALFORMED=11    # unparseable line or unknown key
readonly EX_CONFIG_INCOMPLETE=12   # required keys missing or empty
readonly EX_LOCAL_SAVE_BAD=13      # local save path missing/not a dir/empty
readonly EX_HUB_PATH_MISSING=14    # hub path absent on the hub host
readonly EX_ROOT=15                # running as root
readonly EX_BASH_OLD=16            # bash older than 3.2
readonly EX_TOOL_MISSING=17        # rsync or ssh not on PATH

readonly EX_TS_MISSING=20          # tailscale binary not found
readonly EX_TS_DAEMON=21           # tailscaled not running
readonly EX_TS_LOGGED_OUT=22       # node logged out or Stopped
readonly EX_TS_INTERACTIVE=23      # tailscale up needs a browser login
readonly EX_TS_NO_PEER=24          # hub host absent from the tailnet
readonly EX_TS_PEER_OFFLINE=25     # hub host present but offline
readonly EX_TS_PING=26             # tailscale ping failed or timed out

readonly EX_SSH_FAILED=30          # non-interactive ssh failed
readonly EX_SSH_HOSTKEY=31         # host key unknown or changed
readonly EX_HUB_PERMS=32           # remote user cannot read/write hub dir
readonly EX_RSYNC=33               # rsync exited non-zero
readonly EX_DISK_FULL=34           # no space on either side

readonly EX_GAME_RUNNING=40        # game is running on this machine
readonly EX_GAME_NO_START=41       # game never started (Steam/appid wrong)

readonly EX_LOCK_REMOTE=50         # hub lock held by another host
readonly EX_LOCK_CREATE=51         # lock could not be created
readonly EX_LOCK_LOCAL=52          # another sts is running on this machine

readonly EX_CONFLICT=60            # both sides changed since last sync
readonly EX_CONFLICT_FIRSTRUN=61   # first run, both sides non-empty
readonly EX_HUB_EMPTY=62           # hub empty, explicit first push needed
readonly EX_SNAPSHOT=63            # snapshot failed, so no overwrite allowed

readonly EX_BACKUP_NOT_MOUNTED=70  # backup volume not mounted
readonly EX_BACKUP_NOT_HUB=71      # sts backup run off the hub host

# --------------------------------------------------------------------------
# Globals set during startup
# --------------------------------------------------------------------------
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$PROG"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$PROG"
STATE_FILE="$STATE_DIR/last-sync.json"
LOG_DIR="$HOME/Library/Logs/$PROG"
LOG_FILE="$LOG_DIR/$PROG.log"

OPT_DRY_RUN=0
OPT_VERBOSE=0
OPT_FORCE=""          # "", "local" or "hub"
OPT_OFFLINE_OK=0
OPT_FIX=0
COMMAND=""

IS_HUB=0              # 1 when this machine is the hub host
HUB_ENDPOINT=""       # resolved MagicDNS name or tailnet IP
HUB_ENDPOINT_KIND=""  # "magicdns" or "tailnet-ip" or "local"
HUB_DNS=""            # the peer's MagicDNS name, when it has one
HUB_IP=""             # the peer's tailnet IP
TS_BIN=""

LOCAL_LOCK_FILE=""
HELD_HUB_LOCK=0
HUB_LOCK_NONCE=""
HUB_LOCK_TRIES=0     # bounds the clear-then-retry path in acquire_hub_lock
IN_SWAP=0            # 1 while a directory swap is half-done - see on_exit
BACKUP_PENDING=""    # a backup directory that is not yet known to be good
DYING=0              # 1 once die() has been entered, so on_err stays quiet
CLEANUP_PATHS=""      # newline separated, removed by the EXIT trap

# Config values, all prefixed CFG_. Defaults for optional keys only.
CFG_HUB_HOST=""
CFG_HUB_USER=""
CFG_HUB_PATH=""
CFG_LOCAL_SAVE_PATH=""
CFG_STEAM_APPID=""
CFG_GAME_PROCESS_NAME=""
CFG_GAME_START_TIMEOUT="90"
CFG_SSH_PORT="22"
CFG_SSH_EXTRA_OPTS=""
CFG_SSH_CONNECT_TIMEOUT="10"
CFG_PREFER_MAGICDNS="1"
CFG_SYNC_EXCLUDE=""
CFG_SNAPSHOT_KEEP="10"
CFG_LOCK_TTL_SECONDS="3600"
CFG_CLOCK_SKEW_TOLERANCE="300"
CFG_BACKUP_VOLUME=""
CFG_BACKUP_DEST=""
CFG_BACKUP_KEEP="30"
CFG_BACKUP_MOUNT_WAIT="0"
CFG_LOG_MAX_BYTES="5242880"
CFG_LOG_KEEP="3"
CFG_LOG_LEVEL="INFO"

# --------------------------------------------------------------------------
# Logging. stdout stays short and human readable; detail goes to the log.
# --------------------------------------------------------------------------

iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

log_level_num() {
    case "$1" in
        DEBUG) echo 10 ;;
        INFO)  echo 20 ;;
        WARN)  echo 30 ;;
        ERROR) echo 40 ;;
        *)     echo 20 ;;
    esac
}

rotate_log() {
    [ -f "$LOG_FILE" ] || return 0
    local size
    size=$(stat -f%z "$LOG_FILE" 2>/dev/null || echo 0)
    [ "$size" -lt "$CFG_LOG_MAX_BYTES" ] && return 0

    local i
    i=$CFG_LOG_KEEP
    rm -f "$LOG_FILE.$i" 2>/dev/null || true
    while [ "$i" -gt 1 ]; do
        local prev=$((i - 1))
        [ -f "$LOG_FILE.$prev" ] && mv -f "$LOG_FILE.$prev" "$LOG_FILE.$i"
        i=$prev
    done
    mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || true
}

# log LEVEL STEP MESSAGE...
log() {
    local level="$1" step="$2"; shift 2
    local msg="$*"
    local threshold current
    threshold=$(log_level_num "$CFG_LOG_LEVEL")
    current=$(log_level_num "$level")

    if [ "$current" -ge "$threshold" ]; then
        mkdir -p "$LOG_DIR" 2>/dev/null || true
        rotate_log
        printf '%s %-5s %-14s %s\n' "$(iso_now)" "$level" "$step" "$msg" \
            >> "$LOG_FILE" 2>/dev/null || true
    fi
    if [ "$OPT_VERBOSE" -eq 1 ] && [ "$current" -ge "$threshold" ]; then
        printf '%s %-5s %-14s %s\n' "$(iso_now)" "$level" "$step" "$msg" >&2
    fi
}

# say MESSAGE - the short human line on stdout
say()  { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }

# die EXITCODE STEP MESSAGE... - log at ERROR, print to stderr, exit
die() {
    local code="$1" step="$2"; shift 2
    DYING=1
    log ERROR "$step" "exit=$code $*"
    printf 'error: %s\n' "$*" >&2
    printf 'exit code %s - see %s\n' "$code" "$LOG_FILE" >&2
    exit "$code"
}

# --------------------------------------------------------------------------
# Traps. Cleanup and lock release always run, on every exit path.
# --------------------------------------------------------------------------

on_err() {
    local code=$? line=${1:-?}
    [ "${DYING:-0}" -eq 1 ] && return 0
    log ERROR trap "unhandled failure at line $line, status $code"
}

on_exit() {
    local code=$?
    release_hub_lock
    # While a swap is in flight the staged copy may be the ONLY complete copy
    # of the saves. Never sweep it away on a signal; leave a breadcrumb that
    # the next run recovers from instead.
    if [ "$IN_SWAP" -eq 1 ]; then
        log ERROR trap "interrupted mid-swap - staged data left in place deliberately, run $PROG again to recover"
        printf 'error: interrupted while swapping directories.\n' >&2
        printf 'Nothing was deleted. Re-run %s and it will recover.\n' "$PROG" >&2
        # Still release the lock: the guard protects data, not the lock file.
        [ -n "$LOCAL_LOCK_FILE" ] && rm -f "$LOCAL_LOCK_FILE" 2>/dev/null
        return $code
    fi
    if [ -n "$BACKUP_PENDING" ] && [ -d "$BACKUP_PENDING" ]; then
        log WARN backup "removing incomplete backup $BACKUP_PENDING"
        rm -rf "$BACKUP_PENDING" 2>/dev/null || true
    fi
    local p
    printf '%s\n' "$CLEANUP_PATHS" | while IFS= read -r p; do
        [ -n "$p" ] && rm -rf "$p" 2>/dev/null || true
    done
    [ -n "$LOCAL_LOCK_FILE" ] && rm -f "$LOCAL_LOCK_FILE" 2>/dev/null || true
    log DEBUG trap "exit status $code"
    return $code
}

trap 'on_err $LINENO' ERR
trap on_exit EXIT
# Without these, a Ctrl-C or a launchd SIGTERM exits 0 and an interrupted
# transfer is reported as a clean success.
trap 'exit 130' INT
trap 'exit 143' TERM

cleanup_later() { CLEANUP_PATHS="$CLEANUP_PATHS
$1"; }

# --------------------------------------------------------------------------
# Config. The file is parsed, never sourced - a config file must not be able
# to execute code. Unknown keys are a hard error rather than a shrug.
# --------------------------------------------------------------------------

config_key_known() {
    case "$1" in
        HUB_HOST|HUB_USER|HUB_PATH) return 0 ;;
        LOCAL_SAVE_PATH) return 0 ;;
        STEAM_APPID|GAME_PROCESS_NAME|GAME_START_TIMEOUT) return 0 ;;
        SSH_PORT|SSH_EXTRA_OPTS|SSH_CONNECT_TIMEOUT|PREFER_MAGICDNS) return 0 ;;
        SYNC_EXCLUDE) return 0 ;;
        SNAPSHOT_KEEP|LOCK_TTL_SECONDS|CLOCK_SKEW_TOLERANCE) return 0 ;;
        BACKUP_VOLUME|BACKUP_DEST|BACKUP_KEEP|BACKUP_MOUNT_WAIT) return 0 ;;
        LOG_MAX_BYTES|LOG_KEEP|LOG_LEVEL) return 0 ;;
        *) return 1 ;;
    esac
}

config_key_is_path() {
    case "$1" in
        HUB_PATH|LOCAL_SAVE_PATH|BACKUP_VOLUME|BACKUP_DEST)
            return 0 ;;
        *) return 1 ;;
    esac
}

# Only a leading ~/ is expanded, and only in path keys. Nothing else.
expand_tilde() {
    case "$1" in
        "~/"*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
        "~")   printf '%s' "$HOME" ;;
        *)     printf '%s' "$1" ;;
    esac
}

load_config() {
    [ -e "$CONFIG_FILE" ] || die $EX_CONFIG_MISSING config \
        "no config at $CONFIG_FILE - copy config.example there and edit it"
    [ -f "$CONFIG_FILE" ] || die $EX_CONFIG_MISSING config \
        "$CONFIG_FILE exists but is not a regular file"
    [ -r "$CONFIG_FILE" ] || die $EX_CONFIG_MISSING config \
        "$CONFIG_FILE is not readable by $(whoami)"

    local lineno=0 line key val
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        # strip trailing CR so a file edited on another platform still parses
        line="${line%$'\r'}"
        case "$line" in
            ''|'#'*) continue ;;
        esac
        case "$line" in
            *=*) ;;
            *) die $EX_CONFIG_MALFORMED config \
                 "$CONFIG_FILE line $lineno is not KEY=value: $line" ;;
        esac

        key="${line%%=*}"
        val="${line#*=}"
        # trim surrounding whitespace on the key only; values are literal
        key="$(printf '%s' "$key" | tr -d '[:space:]')"

        config_key_known "$key" || die $EX_CONFIG_MALFORMED config \
            "$CONFIG_FILE line $lineno: unknown key '$key' - see config.example"

        # Trim surrounding whitespace so `KEY = value` does not smuggle a
        # space into the value.
        val="${val#"${val%%[![:space:]]*}"}"
        val="${val%"${val##*[![:space:]]}"}"

        if config_key_is_path "$key" && [ -n "$val" ]; then
            val="$(expand_tilde "$val")"
            # Strip trailing slashes: `mv dir/ dir.old` fails with EINVAL,
            # and every path here is used as an operand, never a directory
            # suffix.
            while :; do
                case "$val" in
                    /) break ;;
                    */) val="${val%/}" ;;
                    *) break ;;
                esac
            done
        fi
        printf -v "CFG_$key" '%s' "$val"
    done < "$CONFIG_FILE"

    log DEBUG config "loaded $CONFIG_FILE"
}

# Every missing required key is reported at once, not one per run.
validate_config() {
    local missing="" k v name
    for k in HUB_HOST HUB_USER HUB_PATH LOCAL_SAVE_PATH STEAM_APPID \
             GAME_PROCESS_NAME BACKUP_VOLUME BACKUP_DEST; do
        eval "v=\${CFG_$k}"
        [ -n "$v" ] || missing="$missing $k"
    done
    if [ -n "$missing" ]; then
        printf 'error: required config keys are missing or empty:\n' >&2
        for k in $missing; do printf '  %s\n' "$k" >&2; done
        printf 'edit %s - see config.example for what each one means\n' \
            "$CONFIG_FILE" >&2
        log ERROR config "missing required keys:$missing"
        exit $EX_CONFIG_INCOMPLETE
    fi

    # Numeric keys must actually be numeric, or later arithmetic lies.
    for k in GAME_START_TIMEOUT SSH_PORT SSH_CONNECT_TIMEOUT PREFER_MAGICDNS \
             SNAPSHOT_KEEP LOCK_TTL_SECONDS CLOCK_SKEW_TOLERANCE BACKUP_KEEP \
             BACKUP_MOUNT_WAIT LOG_MAX_BYTES LOG_KEEP; do
        eval "v=\${CFG_$k}"
        case "$v" in
            ''|*[!0-9]*) die $EX_CONFIG_MALFORMED config \
                "$k must be a non-negative integer, got '$v'" ;;
        esac
    done

    case "$CFG_LOG_LEVEL" in
        DEBUG|INFO|WARN|ERROR) ;;
        *) die $EX_CONFIG_MALFORMED config \
             "LOG_LEVEL must be DEBUG, INFO, WARN or ERROR, got '$CFG_LOG_LEVEL'" ;;
    esac

    case "$CFG_HUB_PATH" in
        /*) ;;
        *) die $EX_CONFIG_MALFORMED config \
             "HUB_PATH must be absolute - it is evaluated on the hub host, where ~ is the hub user's home, got '$CFG_HUB_PATH'" ;;
    esac

    # This restriction is now about rsync alone. hub_exec_args passes values
    # as positional parameters, so ssh no longer parses them as syntax - but
    # rsync hands a remote path to the hub's login shell itself, and
    # openrsync has no --protect-args, so a space still splits a transfer in
    # two and a metacharacter still reaches a shell. Lifting this means
    # solving that first; see the note in README.
    for k in HUB_PATH LOCAL_SAVE_PATH BACKUP_VOLUME BACKUP_DEST; do
        eval "v=\${CFG_$k}"
        case "$v" in
            *[!A-Za-z0-9._/@+-]*)
                die $EX_CONFIG_MALFORMED config \
                    "$k contains a character that cannot survive being passed to a remote shell: '$v'. Allowed: letters, digits, and . _ / @ + - (no spaces, quotes or shell metacharacters)." ;;
        esac
    done

    for name in $CFG_SYNC_EXCLUDE; do
        case "$name" in
            *[!A-Za-z0-9._*@+-]*)
                die $EX_CONFIG_MALFORMED config \
                    "SYNC_EXCLUDE entry '$name' contains an unsafe character" ;;
        esac
    done

    # L4: on the hub, both sides are local paths. If one contained the other,
    # push would move the live save directory out from under the game.
    if [ "$CFG_HUB_PATH" = "$CFG_LOCAL_SAVE_PATH" ]; then
        die $EX_CONFIG_MALFORMED config \
            "HUB_PATH and LOCAL_SAVE_PATH are the same directory. The hub must be separate from the game's save directory, on every machine including the hub itself."
    fi
    case "$CFG_LOCAL_SAVE_PATH/" in
        "$CFG_HUB_PATH"/*) die $EX_CONFIG_MALFORMED config \
            "LOCAL_SAVE_PATH ($CFG_LOCAL_SAVE_PATH) is inside HUB_PATH ($CFG_HUB_PATH) - a push would move the live save directory out from under the game" ;;
    esac
    case "$CFG_HUB_PATH/" in
        "$CFG_LOCAL_SAVE_PATH"/*) die $EX_CONFIG_MALFORMED config \
            "HUB_PATH ($CFG_HUB_PATH) is inside LOCAL_SAVE_PATH ($CFG_LOCAL_SAVE_PATH) - the hub would be synced into itself" ;;
    esac

    # BACKUP_DEST under BACKUP_VOLUME, or the mount check means nothing.
    case "$CFG_BACKUP_DEST" in
        "$CFG_BACKUP_VOLUME"/*) ;;
        *) die $EX_CONFIG_MALFORMED config \
             "BACKUP_DEST ($CFG_BACKUP_DEST) must live under BACKUP_VOLUME ($CFG_BACKUP_VOLUME)" ;;
    esac

    log DEBUG config "validated"
}

# --------------------------------------------------------------------------
# Preflight: the checks that do not need the network.
# --------------------------------------------------------------------------

check_not_root() {
    if [ "$(id -u)" -eq 0 ]; then
        die $EX_ROOT preflight \
            "refusing to run as root - saves belong to your user and root would leave files your user cannot rewrite"
    fi
}

check_bash_version() {
    local major minor
    major="${BASH_VERSINFO[0]}"
    minor="${BASH_VERSINFO[1]}"
    if [ "$major" -lt 3 ] || { [ "$major" -eq 3 ] && [ "$minor" -lt 2 ]; }; then
        die $EX_BASH_OLD preflight \
            "bash 3.2 or newer required, running $BASH_VERSION"
    fi
}

check_tools() {
    local missing=""
    command -v rsync   >/dev/null 2>&1 || missing="$missing rsync"
    command -v ssh     >/dev/null 2>&1 || missing="$missing ssh"
    command -v python3 >/dev/null 2>&1 || missing="$missing python3"
    if [ -n "$missing" ]; then
        die $EX_TOOL_MISSING preflight \
            "required tools not on PATH:$missing"
    fi
    log DEBUG preflight "rsync=$(command -v rsync) ssh=$(command -v ssh)"
}

# Recover from a run that died between the two renames of a swap, and clear
# staging directories left by failed transfers.
recover_orphans() {
    local mode="${1:-sweep}" parent old incoming age now cand
    parent="$(dirname "$CFG_LOCAL_SAVE_PATH")"

    if [ ! -d "$CFG_LOCAL_SAVE_PATH" ]; then
        old=""
        for cand in "$CFG_LOCAL_SAVE_PATH".sts-old-*; do
            [ -d "$cand" ] || continue
            old="$cand"
            break
        done
        if [ -n "$old" ]; then
            log ERROR recover "interrupted swap detected: $CFG_LOCAL_SAVE_PATH missing, saves parked at $old"
            printf 'error: a previous run was interrupted while swapping directories.\n' >&2
            printf '\nYour saves are INTACT at:\n  %s\n' "$old" >&2
            printf '\nRestore them with:\n  mv %s %s\n' "$old" "$CFG_LOCAL_SAVE_PATH" >&2
            printf '\nNothing else will run until you do - this is deliberate, so an\n' >&2
            printf 'empty save directory cannot be created on top of the recovery.\n' >&2
            exit $EX_LOCAL_SAVE_BAD
        fi
    fi

    # A staging directory younger than this may belong to a run that is
    # still going. We hold the local lock, so that can only be a run on the
    # other side of a crash - but the cost of waiting is nil and the cost of
    # deleting live data is total.
    now="$(date -u +%s)"
    for incoming in "$parent"/.sts-incoming-*; do
        [ -d "$incoming" ] || continue
        age=$(( now - $(stat -f%m "$incoming" 2>/dev/null || echo "$now") ))
        if [ "$mode" = "check" ]; then
            log INFO recover "staging directory present: $incoming (${age}s old)"
            continue
        fi
        if [ "$age" -lt 300 ]; then
            log WARN recover "leaving recent staging directory $incoming (${age}s old)"
            continue
        fi
        log WARN recover "removing stale staging directory $incoming (${age}s old)"
        rm -rf "$incoming"
    done

    # An interrupt between a successful swap and the final cleanup leaves a
    # complete previous generation behind. Report it rather than let it
    # accumulate silently until a pid collision destroys it.
    for cand in "$CFG_LOCAL_SAVE_PATH".sts-old-*; do
        [ -d "$cand" ] || continue
        log WARN recover "previous generation left at $cand - safe to delete once you are happy"
    done
    return 0
}

# Local save directory must exist, be a directory, and contain something.
# An empty local save directory is a real state, not a fresh start.
check_local_save_path() {
    local p="$CFG_LOCAL_SAVE_PATH"
    if [ -L "$p" ]; then
        local real
        real="$(cd "$p" 2>/dev/null && pwd -P || true)"
        if [ -z "$real" ]; then
            die $EX_LOCAL_SAVE_BAD preflight \
                "LOCAL_SAVE_PATH is a symlink that does not resolve: $p"
        fi
        log WARN preflight "LOCAL_SAVE_PATH is a symlink, using its target $real"
        warn "LOCAL_SAVE_PATH is a symlink; operating on its target $real"
        CFG_LOCAL_SAVE_PATH="$real"
        p="$real"
    fi
    [ -e "$p" ] || die $EX_LOCAL_SAVE_BAD preflight \
        "LOCAL_SAVE_PATH does not exist: $p - launch the game once so it creates it, then re-run"
    [ -d "$p" ] || die $EX_LOCAL_SAVE_BAD preflight \
        "LOCAL_SAVE_PATH is not a directory: $p"
    [ -r "$p" ] || die $EX_LOCAL_SAVE_BAD preflight \
        "LOCAL_SAVE_PATH is not readable: $p"
}


# --------------------------------------------------------------------------
# Tailscale
# --------------------------------------------------------------------------

readonly TS_APP_PATH="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

find_tailscale() {
    if [ -x "$TS_APP_PATH" ]; then
        TS_BIN="$TS_APP_PATH"
        log DEBUG tailscale "using App Store binary $TS_BIN"
        return 0
    fi
    if command -v tailscale >/dev/null 2>&1; then
        TS_BIN="$(command -v tailscale)"
        log DEBUG tailscale "using PATH binary $TS_BIN"
        return 0
    fi
    die $EX_TS_MISSING tailscale \
        "tailscale not found at $TS_APP_PATH nor on PATH - install the Tailscale app or 'brew install tailscale'"
}

# Emits the raw JSON. Distinguishes "daemon is down" from "command failed".
ts_status_json() {
    local out rc
    set +e
    out="$("$TS_BIN" status --json 2>&1)"
    rc=$?
    set -e
    if [ $rc -ne 0 ]; then
        case "$out" in
            *"is not running"*|*"connect: no such file or directory"*|\
            *"failed to connect to local backend"*|*"Connection refused"*)
                die $EX_TS_DAEMON tailscale \
                    "tailscaled is not running - start the Tailscale app, or 'sudo tailscaled install-system-daemon'" ;;
            *)
                die $EX_TS_DAEMON tailscale \
                    "tailscale status failed (rc=$rc): $out" ;;
        esac
    fi
    printf '%s' "$out"
}

ts_backend_state() {
    printf '%s' "$1" | python3 -c \
        'import json,sys; print(json.load(sys.stdin).get("BackendState",""))'
}

# States 11 and 12: try `tailscale up` exactly once, then re-check. If it
# wants a browser, say so and get out rather than blocking forever.
ts_ensure_up() {
    local json state
    json="$(ts_status_json)"
    state="$(ts_backend_state "$json")"
    log DEBUG tailscale "backend state $state"

    if [ "$state" = "Running" ]; then
        printf '%s' "$json"
        return 0
    fi

    log WARN tailscale "backend state is $state, attempting 'tailscale up' once"
    say "Tailscale is $state - bringing it up (one attempt)..."

    local out rc
    set +e
    out="$("$TS_BIN" up --timeout=30s 2>&1)"
    rc=$?
    set -e

    # An auth URL means a human has to click. Never hang waiting for it.
    case "$out" in
        *"https://login.tailscale.com/"*)
            local url
            url="$(printf '%s' "$out" | grep -o 'https://login\.tailscale\.com/[A-Za-z0-9/._-]*' | head -1)"
            log ERROR tailscale "interactive login required: $url"
            printf 'error: Tailscale needs an interactive login or reauth.\n' >&2
            printf 'Open this URL, then re-run:\n  %s\n' "$url" >&2
            exit $EX_TS_INTERACTIVE ;;
        *"Reauthentication required"*|*"key expired"*|*"NeedsLogin"*)
            log ERROR tailscale "reauth required: $out"
            printf 'error: Tailscale needs reauthentication. Run:\n  %s up\n' "$TS_BIN" >&2
            exit $EX_TS_INTERACTIVE ;;
    esac

    json="$(ts_status_json)"
    state="$(ts_backend_state "$json")"
    if [ "$state" != "Running" ]; then
        log ERROR tailscale "still $state after 'tailscale up' (rc=$rc): $out"
        printf 'error: Tailscale is still %s after one "tailscale up".\n' "$state" >&2
        printf 'tailscale up said:\n%s\n' "$out" >&2
        exit $EX_TS_LOGGED_OUT
    fi
    log INFO tailscale "backend now Running after one 'tailscale up'"
    printf '%s' "$json"
}

# Prints "DNSName<TAB>IP<TAB>Online" for the hub peer, or nothing if absent.
ts_find_peer() {
    local json="$1" host="$2"
    printf '%s' "$json" | python3 -c '
import json, sys
want = sys.argv[1].lower()
d = json.load(sys.stdin)
for p in list(d.get("Peer", {}).values()) + [d.get("Self", {})]:
    if not p:
        continue
    dns = (p.get("DNSName") or "").rstrip(".")
    host = (p.get("HostName") or "")
    short = dns.split(".")[0]
    if want in (host.lower(), short.lower(), dns.lower()):
        ips = p.get("TailscaleIPs") or []
        v4 = next((i for i in ips if ":" not in i), ips[0] if ips else "")
        print("%s\t%s\t%s" % (dns, v4, "1" if p.get("Online") else "0"))
        break
' "$host"
}

# Decide how we address the hub: MagicDNS if it resolves, tailnet IP if not.
# On a machine whose tailscaled does not install a system resolver the IP
# fallback is the normal path, so it is logged at INFO, not WARN.
resolve_hub_endpoint() {
    local json peer dns ip online

    json="$(ts_ensure_up)"
    peer="$(ts_find_peer "$json" "$CFG_HUB_HOST")"

    if [ -z "$peer" ]; then
        die $EX_TS_NO_PEER tailscale \
            "hub host '$CFG_HUB_HOST' is not in this tailnet at all - check HUB_HOST against '$TS_BIN status', or the machine has never joined"
    fi

    dns="$(printf '%s' "$peer"  | cut -f1)"
    ip="$(printf '%s' "$peer"   | cut -f2)"
    HUB_DNS="$dns"
    HUB_IP="$ip"
    online="$(printf '%s' "$peer" | cut -f3)"

    if [ "$online" != "1" ]; then
        if [ "$OPT_OFFLINE_OK" -eq 1 ]; then
            log WARN tailscale "hub $CFG_HUB_HOST is OFFLINE, continuing under --offline-ok"
            HUB_ENDPOINT=""
            HUB_ENDPOINT_KIND="offline"
            return 0
        fi
        die $EX_TS_PEER_OFFLINE tailscale \
            "hub host '$CFG_HUB_HOST' ($ip) is offline - wake it, or re-run with --offline-ok to play on the local save without syncing"
    fi

    if [ "$CFG_PREFER_MAGICDNS" -eq 1 ] && [ -n "$dns" ] && \
       ping -c1 -t2 "$dns" >/dev/null 2>&1; then
        HUB_ENDPOINT="$dns"
        HUB_ENDPOINT_KIND="magicdns"
        log INFO tailscale "hub endpoint $dns (MagicDNS)"
    else
        HUB_ENDPOINT="$ip"
        HUB_ENDPOINT_KIND="tailnet-ip"
        if [ "$CFG_PREFER_MAGICDNS" -eq 1 ]; then
            log INFO tailscale "MagicDNS name '$dns' did not resolve, falling back to tailnet IP $ip"
            say "note: MagicDNS did not resolve, using tailnet IP $ip"
        else
            log INFO tailscale "hub endpoint $ip (tailnet IP, MagicDNS disabled by config)"
        fi
    fi

    local out rc
    set +e
    out="$("$TS_BIN" ping --c 3 --timeout 5s "$ip" 2>&1)"
    rc=$?
    set -e
    if [ $rc -ne 0 ]; then
        log ERROR tailscale "tailscale ping $ip failed: $out"
        die $EX_TS_PING tailscale \
            "hub '$CFG_HUB_HOST' reports online but 'tailscale ping $ip' failed - $out"
    fi
    log DEBUG tailscale "ping ok: $(printf '%s' "$out" | head -1)"
}

# --------------------------------------------------------------------------
# Hub access. The hub is reached by ssh, or by plain local paths when this
# machine IS the hub. Everything above this layer uses the same calls.
# --------------------------------------------------------------------------

readonly SNAP_DIRNAME="star-traders-sync-snapshots"
readonly LOCK_DIRNAME=".sts-lock"

# Does CFG_HUB_HOST name this machine?
#
# Compared case-insensitively against BOTH the node's HostName and the short
# MagicDNS label, because they can differ: a rename in the admin console
# changes one and not the other, and Tailscale suffixes -1 or -2 when two
# machines collide on a name - entirely possible with two Macs.
#
# One copy, used by detect_self_is_hub and by doctor. Doctor previously had
# its own version comparing HostName only, so on a machine where the two
# names differed it decided the hub was remote, tried to ssh to itself, and
# skipped every hub check without saying so.
hub_host_matches() {
    local host="$1" dns="$2" want
    want="$(printf '%s' "$CFG_HUB_HOST" | tr '[:upper:]' '[:lower:]')"
    host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
    dns="$(printf '%s' "$dns" | tr '[:upper:]' '[:lower:]')"
    [ "$want" = "$host" ] || [ "$want" = "$dns" ]
}

detect_self_is_hub() {
    local self_host self_dns
    local json
    json="$(ts_status_json)"
    self_host="$(printf '%s' "$json" | python3 -c \
        'import json,sys; print((json.load(sys.stdin).get("Self",{}).get("HostName") or ""))')"
    self_dns="$(printf '%s' "$json" | python3 -c \
        'import json,sys; print((json.load(sys.stdin).get("Self",{}).get("DNSName") or "").rstrip(".").split(".")[0])')"

    if hub_host_matches "$self_host" "$self_dns"; then
        IS_HUB=1
        HUB_ENDPOINT_KIND="local"
        log INFO hub "this machine is the hub ($self_host) - using local paths, no ssh"
    else
        IS_HUB=0
        log DEBUG hub "this machine is $self_host, hub is $CFG_HUB_HOST"
    fi
}

ssh_opts() {
    # BatchMode, timeout and StrictHostKeyChecking are fixed on purpose.
    # An unknown or changed host key must fail loudly, never auto-accept.
    printf '%s' "-o BatchMode=yes -o ConnectTimeout=$CFG_SSH_CONNECT_TIMEOUT \
-o StrictHostKeyChecking=yes -p $CFG_SSH_PORT $CFG_SSH_EXTRA_OPTS"
}

ssh_target() { printf '%s@%s' "$CFG_HUB_USER" "$HUB_ENDPOINT"; }

# The exact command a human can paste to reproduce a failure by hand.
ssh_repro_cmd() {
    printf 'ssh %s %s' "$(ssh_opts)" "$(ssh_target)"
}

# Single-quote a value so a shell reads it back as one literal word.
# Every embedded quote is closed, escaped and reopened: ' -> '\''
shq() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# hub_exec COMMAND - run a shell command where the hub lives.
#
# The command is shell TEXT, so anything interpolated into it is code. Use
# it only for commands with no variable parts; everything else belongs in
# hub_exec_args.
hub_exec() {
    local cmd="$1"
    if [ "$IS_HUB" -eq 1 ]; then
        /bin/bash -c "$cmd"
    else
        # shellcheck disable=SC2086
        ssh $(ssh_opts) "$(ssh_target)" "$cmd"
    fi
}

# hub_exec_args SCRIPT ARG... - run SCRIPT where the hub lives, with ARGs
# available as "$1", "$2" and so on.
#
# This exists because building shell text out of config values makes those
# values executable. A path containing a quote - /Users/dan/Daniel's saves
# is entirely ordinary on macOS - turned a sync into arbitrary code
# execution on BOTH machines, and the call sites that did it included ones
# running rm -rf and mv on the hub.
#
# Values now arrive as positional parameters, which survive both bash -c
# and a remote shell without ever being parsed as syntax. The script itself
# is a fixed literal; only the data varies.
hub_exec_args() {
    local script="$1"; shift
    if [ "$IS_HUB" -eq 1 ]; then
        /bin/bash -c "$script" sts "$@"
    else
        local quoted="" a
        for a in "$@"; do
            quoted="$quoted $(shq "$a")"
        done
        # bash -s reads the script from stdin, so the script text never
        # passes through the remote shell's parser as a command line.
        # shellcheck disable=SC2086
        ssh $(ssh_opts) "$(ssh_target)" "bash -s --$quoted" <<SCRIPT
$script
SCRIPT
    fi
}

# The same machine is reachable by MagicDNS name AND tailnet IP, and each
# address is trusted separately by ssh. If one of them is already in
# known_hosts, the key it holds is a verification source the user has
# already accepted, so we can do the comparison for them instead of making
# them eyeball two SHA256 strings. If neither is trusted, fall back to
# out-of-band verification - we never auto-accept.
hostkey_help() {
    local want="$1" alt="" altkey="" wantkey=""

    if [ "$want" = "$HUB_DNS" ]; then alt="$HUB_IP"; else alt="$HUB_DNS"; fi

    if [ -n "$alt" ] && ssh-keygen -F "$alt" >/dev/null 2>&1; then
        altkey="$(ssh-keygen -F "$alt" 2>/dev/null | grep -v '^#' | awk '{print $3}' | head -1)"
        wantkey="$(ssh-keyscan -t ed25519 "$want" 2>/dev/null | awk '{print $3}' | head -1)"
        if [ -n "$altkey" ] && [ "$altkey" = "$wantkey" ]; then
            printf 'You already trust this machine as %s, and %s presents the\n' "$alt" "$want"
            printf 'identical host key. Adding the name is safe. Run:\n\n' >&2
            printf '    ssh-keyscan -t ed25519 %s >> ~/.ssh/known_hosts\n\n' "$want" >&2
            printf 'Then re-run this command.\n' >&2
            log INFO ssh "advised adding $want, key matches already-trusted $alt"
            return 0
        fi
        if [ -n "$altkey" ] && [ -n "$wantkey" ]; then
            printf 'WARNING: you trust %s, but %s presents a DIFFERENT key.\n' "$alt" "$want" >&2
            printf 'Do not add it. Investigate before going further.\n' >&2
            log ERROR ssh "key mismatch between $alt and $want"
            return 0
        fi
    fi

    printf 'Not auto-accepting it. Verify out of band, then add it.\n\n' >&2
    printf 'Copy this whole block - it does the comparison for you:\n\n' >&2
    printf '    # 1. ON THE HUB (%s), print its real fingerprint:\n' "$CFG_HUB_HOST" >&2
    printf '    ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub\n\n' >&2
    printf '    # 2. HERE, paste that SHA256:... value in and run it:\n' >&2
    printf '    EXPECT="SHA256:PASTE_IT_HERE"\n' >&2
    printf '    GOT=$(ssh-keyscan -t ed25519 %s 2>/dev/null | ssh-keygen -lf - | awk "{print \\$2}")\n' "$want" >&2
    printf '    [ "$GOT" = "$EXPECT" ] \\\n' >&2
    printf '      && ssh-keyscan -t ed25519 %s >> ~/.ssh/known_hosts && echo "MATCH - added" \\\n' "$want" >&2
    printf '      || echo "MISMATCH: $GOT - do not proceed"\n' >&2
}

# Probe ssh once, and turn its failure modes into distinct exit codes.
check_hub_reachable() {
    if [ "$IS_HUB" -eq 1 ]; then
        log DEBUG ssh "hub is local, skipping ssh probe"
        return 0
    fi
    local out rc
    set +e
    # shellcheck disable=SC2086
    out="$(ssh $(ssh_opts) "$(ssh_target)" 'echo STS_SSH_OK' 2>&1)"
    rc=$?
    set -e

    if [ $rc -eq 0 ] && [ "$out" = "STS_SSH_OK" ]; then
        log DEBUG ssh "ssh to $(ssh_target) ok"
        return 0
    fi

    case "$out" in
        *"HOST IDENTIFICATION HAS CHANGED"*|*"host key for"*"has changed"*)
            log ERROR ssh "host key CHANGED for $HUB_ENDPOINT: $out"
            printf 'error: the SSH host key for %s has CHANGED.\n' "$HUB_ENDPOINT" >&2
            printf 'This is either a reinstalled machine or something is wrong.\n' >&2
            printf 'Verify the new key ON THE HUB, then remove the stale entry:\n' >&2
            printf '  ssh-keygen -R %s\n' "$HUB_ENDPOINT" >&2
            printf 'Compare against, run on the hub:\n' >&2
            printf '  ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub\n' >&2
            exit $EX_SSH_HOSTKEY ;;
        *"No ED25519 host key is known"*|*"Host key verification failed"*|\
        *"No RSA host key is known"*)
            log ERROR ssh "host key UNKNOWN for $HUB_ENDPOINT: $out"
            printf 'error: the SSH host key for %s is not trusted yet.\n\n' "$HUB_ENDPOINT" >&2
            hostkey_help "$HUB_ENDPOINT"
            exit $EX_SSH_HOSTKEY ;;
    esac

    log ERROR ssh "non-interactive ssh failed rc=$rc: $out"
    printf 'error: could not ssh to the hub non-interactively (rc=%s).\n' "$rc" >&2
    printf 'ssh said:\n%s\n' "$out" >&2
    printf 'Reproduce it by hand with:\n  %s\n' "$(ssh_repro_cmd)" >&2
    printf 'If it asks for a password, key auth is not set up:\n' >&2
    printf '  ssh-copy-id -i ~/.ssh/id_ed25519.pub %s\n' "$(ssh_target)" >&2
    exit $EX_SSH_FAILED
}

# Hub directory must exist and be readable AND writable by the hub user.
check_hub_path() {
    local allow_missing="${1:-no}" out rc
    set +e
    out="$(hub_exec_args '
        d="$1"
        if [ ! -e "$d" ]; then
            for cand in "$d".sts-old-*; do
                [ -d "$cand" ] || continue
                echo STS_ORPHAN
                echo "$cand"
                exit 0
            done
            echo STS_NOENT
            exit 0
        fi
        [ -d "$d" ] || { echo STS_NOTDIR; exit 0; }
        [ -r "$d" ] || { echo STS_NOREAD; exit 0; }
        [ -w "$d" ] || { echo STS_NOWRITE; exit 0; }
        echo STS_OK
    ' "$CFG_HUB_PATH" 2>&1)"
    rc=$?
    set -e
    [ $rc -eq 0 ] || die $EX_SSH_FAILED hub "probing hub path failed: $out"

    case "$out" in
        *STS_ORPHAN*)
            local parked
            parked="$(printf '%s' "$out" | grep -v STS_ORPHAN | head -1)"
            log ERROR hub "interrupted hub swap: $CFG_HUB_PATH missing, data parked at $parked"
            printf 'error: a previous run was interrupted while swapping the hub.\n' >&2
            printf '\nThe hub data is INTACT on %s at:\n  %s\n' "$CFG_HUB_HOST" "$parked" >&2
            printf '\nRestore it there with:\n  mv %s %s\n' "$parked" "$CFG_HUB_PATH" >&2
            printf '\nDo NOT create an empty hub - that would make the next push look\n' >&2
            printf 'like a legitimate first seed and orphan this data.\n' >&2
            exit $EX_HUB_PATH_MISSING ;;
        *STS_OK*)      log DEBUG hub "hub path ok: $CFG_HUB_PATH" ; return 0 ;;
        *STS_NOENT*)
            if [ "$allow_missing" = "yes" ]; then
                log INFO hub "hub path does not exist yet - a first seed may create it"
                return 0
            fi
            die $EX_HUB_PATH_MISSING hub \
            "hub path does not exist on $CFG_HUB_HOST: $CFG_HUB_PATH - create it with 'mkdir -p $CFG_HUB_PATH' on the hub, or run 'sts push' which will offer to seed it" ;;
        *STS_NOTDIR*)  die $EX_HUB_PATH_MISSING hub \
            "hub path exists but is not a directory on $CFG_HUB_HOST: $CFG_HUB_PATH" ;;
        *STS_NOREAD*)  die $EX_HUB_PERMS hub \
            "hub user '$CFG_HUB_USER' cannot READ $CFG_HUB_PATH on $CFG_HUB_HOST" ;;
        *STS_NOWRITE*) die $EX_HUB_PERMS hub \
            "hub user '$CFG_HUB_USER' cannot WRITE $CFG_HUB_PATH on $CFG_HUB_HOST - check ownership and mode" ;;
        *) die $EX_HUB_PERMS hub "unexpected hub path probe result: $out" ;;
    esac
}

# --------------------------------------------------------------------------
# Fingerprints. Two directories can have identical file sizes and still hold
# completely different saves - on this pair of machines core.db is 12288
# bytes on both - so content hashes decide, not sizes or mtimes.
# --------------------------------------------------------------------------

# Builds the shell snippet that emits "sha256  size  relpath" per file,
# sorted, excluding snapshots, locks and anything in SYNC_EXCLUDE.
# The manifest script is a fixed literal. The directory and every exclude
# name arrive as positional parameters, so a name containing a quote cannot
# become syntax.
readonly MANIFEST_SCRIPT='
dir="$1"; shift
cd "$dir" 2>/dev/null || exit 0
# set -f covers both building and using $prune_args: it must word-split but
# must NOT glob. SYNC_EXCLUDE legally contains * (see validate_config), and
# without this an entry like *.bak expands against the directory we just
# moved into, turning "-name *.bak" into "-name a.bak b.bak" - which find rejects,
# leaving an empty manifest that nothing downstream detects.
set -f
prune_args=""
for n in "$@"; do
    prune_args="$prune_args ! -name $n ! -path ./$n/*"
done
# shellcheck disable=SC2086
LC_ALL=C find . -type f $prune_args 2>/dev/null | LC_ALL=C sort | while IFS= read -r f; do
    h=$(shasum -a 256 "$f" 2>/dev/null | cut -d" " -f1)
    z=$(stat -f%z "$f" 2>/dev/null)
    if [ -z "$h" ] || [ -z "$z" ]; then
        printf "STS_UNHASHABLE  %s\n" "$f"
    else
        printf "%s  %s  %s\n" "$h" "$z" "$f"
    fi
done
set +f
'

# Emits the exclude names as separate arguments, always including the
# snapshot and lock directories.
manifest_args() {
    local name
    printf '%s\n' "$SNAP_DIRNAME"
    printf '%s\n' "$LOCK_DIRNAME"
    set -f
    for name in $CFG_SYNC_EXCLUDE; do
        printf '%s\n' "$name"
    done
    set +f
}


# Sets the positional parameters to the exclude names, snapshot and lock
# directories first. Callers then pass "$@" straight through.

manifest_local() {
    local dir="$1" nm
    set -- "$SNAP_DIRNAME" "$LOCK_DIRNAME"
    set -f
    for nm in $CFG_SYNC_EXCLUDE; do set -- "$@" "$nm"; done
    set +f
    /bin/bash -c "$MANIFEST_SCRIPT" sts "$dir" "$@"
}

manifest_hub() {
    local nm
    set -- "$SNAP_DIRNAME" "$LOCK_DIRNAME"
    set -f
    for nm in $CFG_SYNC_EXCLUDE; do set -- "$@" "$nm"; done
    set +f
    hub_exec_args "$MANIFEST_SCRIPT" "$CFG_HUB_PATH" "$@"
}

# Refuses rather than guesses when any file could not be fingerprinted.
assert_manifest_hashable() {
    local m="$1" side="$2" bad
    case "$m" in
        *STS_UNHASHABLE*) ;;
        *) return 0 ;;
    esac
    bad="$(printf '%s\n' "$m" | grep STS_UNHASHABLE | sed 's/^STS_UNHASHABLE  //' | head -5)"
    log ERROR manifest "unhashable file(s) on $side"
    printf 'error: some files on the %s side cannot be fingerprinted:\n' "$side" >&2
    printf '%s\n' "$bad" | sed 's/^/  /' >&2
    printf '\nWithout a fingerprint their contents cannot be compared, so sts\n' >&2
    printf 'cannot tell whether they changed. Rename or remove them.\n' >&2
    exit $EX_LOCAL_SAVE_BAD
}

fingerprint_of_manifest() {
    local m="$1"
    if [ -z "$m" ]; then printf 'empty'; return 0; fi
    printf '%s' "$m" | shasum -a 256 | cut -d' ' -f1
}

count_files() {
    local n
    n="$(manifest_local "$1" | grep -c . || true)"
    printf '%s' "${n:-0}"
}

# Newest mtime under a directory, as a unix epoch. 0 when empty.
newest_mtime_local() {
    local dir="$1" newest
    # Same argument-passing discipline as the hub side: this was still
    # interpolating a path into bash -c text.
    newest="$(/bin/bash -c '
        cd "$1" 2>/dev/null || exit 0
        LC_ALL=C find . -type f ! -path "./$2/*" ! -path "./$3/*" \
            -exec stat -f%m {} + 2>/dev/null | LC_ALL=C sort -n | tail -1
    ' sts "$dir" "$SNAP_DIRNAME" "$LOCK_DIRNAME")"
    printf '%s' "${newest:-0}"
}

newest_mtime_hub() {
    local newest
    newest="$(hub_exec_args '
        cd "$1" 2>/dev/null || exit 0
        LC_ALL=C find . -type f ! -path "./$2/*" ! -path "./$3/*" \
            -exec stat -f%m {} + 2>/dev/null | LC_ALL=C sort -n | tail -1
    ' "$CFG_HUB_PATH" "$SNAP_DIRNAME" "$LOCK_DIRNAME")"
    printf '%s' "${newest:-0}"
}

hub_clock_epoch() { hub_exec 'date -u +%s'; }

# --------------------------------------------------------------------------
# Locks. Two layers: a hub lock so two machines cannot both write the hub,
# and a local lock so two sts invocations on one machine cannot race.
# --------------------------------------------------------------------------

# The human-readable name, used in messages only.
this_host_id() { printf '%s' "$(hostname -s)"; }

# The identity the hub lock is actually compared against.
#
# hostname -s can change with DHCP or network conditions on macOS. When it
# did, this machine's own stale lock was thereafter seen as another
# machine's and was never cleared at any age, requiring a manual rm -rf on
# the hub to recover. A value generated once and kept in the state
# directory does not move.
stable_host_id() {
    local f="$STATE_DIR/host-id" tmp id
    if [ -f "$f" ]; then
        id="$(head -1 "$f" 2>/dev/null || true)"
        case "$id" in
            ?*) printf '%s' "$id"; return 0 ;;
        esac
    fi
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    id="$(uuidgen 2>/dev/null || true)"
    [ -n "$id" ] || id="$(this_host_id)-$$-$(date -u +%s)"

    # The first write has to be atomic. `backup` and the sync commands hold
    # different local locks on purpose, so a nightly backup can overlap a
    # manual push; on a machine that has no id yet, both would generate one
    # and a plain `>` would be last-writer-wins. The loser would then carry
    # an id in memory that is not the one on disk, and a lock it left behind
    # would afterwards look like another machine's - reintroducing exactly
    # the permanent lockout this function exists to prevent.
    #
    # ln(1) is atomic and fails if the target exists, so the loser of the
    # race finds out and adopts the winner's id instead of its own.
    # mktemp, not "$f.$$": two processes can share a pid-derived name (a
    # subshell inherits its parent's $$), and then one would link a file the
    # other had already overwritten - returning an id that is not the one on
    # disk, which is the very failure this is guarding against.
    tmp="$(mktemp "$f.XXXXXX" 2>/dev/null || true)"
    [ -n "$tmp" ] || tmp="$f.$$.$RANDOM"
    if printf '%s\n' "$id" > "$tmp" 2>/dev/null && ln "$tmp" "$f" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        printf '%s' "$id"
        return 0
    fi
    rm -f "$tmp" 2>/dev/null || true

    # Either someone else won the race, or the file could not be created.
    id="$(head -1 "$f" 2>/dev/null || true)"
    case "$id" in
        ?*) printf '%s' "$id" ;;
        *)  printf '%s' "$(this_host_id)" ;;   # no persistence: degrade to the old behaviour
    esac
}

# shlock ships with macOS and handles a stale pid for us.
acquire_local_lock() {
    local lockdir holder
    mkdir -p "$STATE_DIR"
    if [ "$COMMAND" = "backup" ]; then
        LOCAL_LOCK_FILE="$STATE_DIR/backup.lock"
        lockdir="$STATE_DIR/backup.lock.d"
    else
        LOCAL_LOCK_FILE="$STATE_DIR/local.lock"
        lockdir="$STATE_DIR/local.lock.d"
    fi

    # mkdir is the atomic part; the pid inside decides whether it is stale.
    # (macOS shlock does NOT break stale locks - it refuses even for a
    # confirmed-dead pid - so relying on it wedged the tool permanently.)
    if ! mkdir "$lockdir" 2>/dev/null; then
        holder="$(cat "$LOCAL_LOCK_FILE" 2>/dev/null || echo '')"
        case "$holder" in
            ''|*[!0-9]*) holder="" ;;
        esac
        if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
            LOCAL_LOCK_FILE=""   # not ours, the EXIT trap must not remove it
            die $EX_LOCK_LOCAL lock \
                "another $PROG is already running on this machine (pid $holder) - wait for it to finish"
        fi
        log WARN lock "clearing stale local lock (pid ${holder:-unknown} is gone)"
        rm -rf "$lockdir"
        if ! mkdir "$lockdir" 2>/dev/null; then
            LOCAL_LOCK_FILE=""
            die $EX_LOCK_LOCAL lock \
                "could not take the local lock at $lockdir - remove it by hand if no $PROG is running"
        fi
    fi
    printf '%s\n' "$$" > "$LOCAL_LOCK_FILE"
    cleanup_later "$lockdir"
    log DEBUG lock "local lock held, pid $$"
}

hub_lock_path() { printf '%s/%s' "$(dirname "$CFG_HUB_PATH")" "$LOCK_DIRNAME"; }

# mkdir is atomic on both HFS+ and APFS, and over ssh it stays atomic because
# it is a single syscall on the far side.
acquire_hub_lock() {
    local lock info out
    # Idempotent: cmd_play runs pull then push in one process.
    [ "$HELD_HUB_LOCK" -eq 1 ] && return 0
    lock="$(hub_lock_path)"
    info="$lock/owner"

    # The sentinel comes FIRST so a missing owner file cannot be mistaken for
    # owner fields. The lock directory's own mtime is reported too, because a
    # run that died between the mkdir and the owner write leaves a lock with
    # no owner at all - and that used to be permanently un-clearable.
    out="$(hub_exec_args '
        lock="$1"; info="$lock/owner"
        if mkdir "$lock" 2>/dev/null; then
            printf "%s\n%s\n%s\n%s\n%s\n%s\n" "$2" "$3" "$4" "$(date -u +%s)" "$5" "$6" > "$info"
            echo STS_LOCK_ACQUIRED
        elif [ ! -d "$lock" ]; then
            echo STS_LOCK_NOCREATE
        else
            echo STS_LOCK_HELD
            if [ -f "$info" ]; then
                echo STS_OWNER
                cat "$info"
            else
                echo STS_NO_OWNER
                stat -f%m "$lock" 2>/dev/null || echo 0
            fi
        fi
    ' "$lock" "$(this_host_id)" "$$" "$(iso_now)" "$HUB_LOCK_NONCE" "$(stable_host_id)" 2>&1)" \
        || die $EX_LOCK_CREATE lock \
        "could not create the hub lock at $lock - is the hub directory writable? ($out)"

    case "$out" in
        *STS_LOCK_ACQUIRED*)
            HELD_HUB_LOCK=1
            HUB_LOCK_TRIES=0
            log DEBUG lock "hub lock acquired at $lock"
            return 0 ;;
        *STS_LOCK_NOCREATE*)
            die $EX_LOCK_CREATE lock \
                "could not create the hub lock at $lock - $(dirname "$CFG_HUB_PATH") is not writable by $CFG_HUB_USER on $CFG_HUB_HOST" ;;
    esac

    # Backstop: clearing a lock then retrying must terminate no matter what
    # the far side reports.
    HUB_LOCK_TRIES=$((HUB_LOCK_TRIES + 1))
    if [ "$HUB_LOCK_TRIES" -gt 2 ]; then
        die $EX_LOCK_CREATE lock \
            "gave up acquiring the hub lock at $lock after $HUB_LOCK_TRIES attempts - clear it by hand on $CFG_HUB_HOST"
    fi

    local now
    now="$(hub_clock_epoch)"

    # A lock directory with no owner file: a run died mid-acquire. Nobody
    # owns it, so nobody can ever claim it. Clear it once it is past the TTL.
    case "$out" in
        *STS_NO_OWNER*)
            local lock_mtime lock_age
            lock_mtime="$(printf '%s' "$out" | sed -n '3p')"
            case "$lock_mtime" in ''|*[!0-9]*) lock_mtime=0 ;; esac
            lock_age=$((now - lock_mtime))
            [ "$lock_age" -lt 0 ] && lock_age=0
            if [ "$lock_age" -ge "$CFG_LOCK_TTL_SECONDS" ]; then
                log WARN lock "CLEARING ownerless hub lock at $lock, age ${lock_age}s"
                warn "clearing an ownerless hub lock (a run died while taking it), ${lock_age}s old"
                hub_exec_args 'rm -rf "$1"' "$lock" || die $EX_LOCK_CREATE lock \
                    "failed to clear the ownerless hub lock at $lock"
                acquire_hub_lock
                return 0
            fi
            log ERROR lock "ownerless hub lock at $lock, age ${lock_age}s < TTL"
            printf 'error: the hub lock exists but has no owner record.\n' >&2
            printf 'A run died while taking it, %s seconds ago.\n' "$lock_age" >&2
            printf 'It clears automatically once older than LOCK_TTL_SECONDS (%s),\n' \
                "$CFG_LOCK_TTL_SECONDS" >&2
            printf 'or remove it on %s by hand:  rm -rf %s\n' "$CFG_HUB_HOST" "$lock" >&2
            exit $EX_LOCK_REMOTE ;;
    esac

    local owner_host owner_pid owner_iso owner_epoch owner_id age is_ours
    owner_host="$(printf  '%s' "$out" | sed -n '3p')"
    owner_pid="$(printf   '%s' "$out" | sed -n '4p')"
    owner_iso="$(printf   '%s' "$out" | sed -n '5p')"
    owner_epoch="$(printf '%s' "$out" | sed -n '6p')"
    owner_id="$(printf    '%s' "$out" | sed -n '8p')"
    case "$owner_epoch" in ''|*[!0-9]*) owner_epoch=0 ;; esac

    age=$((now - owner_epoch))
    [ "$age" -lt 0 ] && age=0

    # Prefer the stable id. Fall back to the hostname for a lock written by
    # a version that predates it, so an upgrade mid-lock still behaves.
    if [ -n "$owner_id" ]; then
        [ "$owner_id" = "$(stable_host_id)" ] && is_ours=1 || is_ours=0
    else
        [ "$owner_host" = "$(this_host_id)" ] && is_ours=1 || is_ours=0
    fi

    # A lock from another machine is never cleared automatically, at any age.
    if [ "$is_ours" -eq 0 ]; then
        log ERROR lock "hub lock held by $owner_host since $owner_iso (${age}s)"
        printf 'error: the hub is locked by another machine.\n' >&2
        printf '  holder: %s (pid %s)\n' "$owner_host" "$owner_pid" >&2
        printf '  since:  %s (%s seconds ago)\n' "$owner_iso" "$age" >&2
        printf 'Wait for it to finish. If that machine crashed, clear it there,\n' >&2
        printf 'or remove %s on the hub by hand.\n' "$lock" >&2
        exit $EX_LOCK_REMOTE
    fi

    # Our own lock from a crashed earlier run: clear only past the TTL, loudly.
    if [ "$age" -ge "$CFG_LOCK_TTL_SECONDS" ]; then
        log WARN lock "CLEARING our own stale hub lock from $owner_iso, age ${age}s >= TTL ${CFG_LOCK_TTL_SECONDS}s (pid $owner_pid)"
        warn "clearing a stale hub lock left by this machine on $owner_iso (${age}s old, pid $owner_pid)"
        hub_exec_args 'rm -rf "$1"' "$lock" || die $EX_LOCK_CREATE lock \
            "failed to clear our stale hub lock at $lock"
        acquire_hub_lock
        return 0
    fi

    log ERROR lock "hub lock held by this host since $owner_iso (${age}s < TTL)"
    printf 'error: the hub is locked by this machine from an earlier run.\n' >&2
    printf '  pid %s, since %s (%s seconds ago)\n' "$owner_pid" "$owner_iso" "$age" >&2
    printf 'It will be cleared automatically once it is older than LOCK_TTL_SECONDS (%s).\n' \
        "$CFG_LOCK_TTL_SECONDS" >&2
    printf 'Or remove it on %s by hand:  rm -rf %s\n' "$CFG_HUB_HOST" "$lock" >&2
    exit $EX_LOCK_REMOTE
}

release_hub_lock() {
    [ "$HELD_HUB_LOCK" -eq 1 ] || return 0
    HELD_HUB_LOCK=0
    local lock info
    lock="$(hub_lock_path)"
    info="$lock/owner"
    # Only remove it if it is still OURS. Deleting someone else's lock is
    # worse than leaking our own.
    hub_exec_args '
        if [ "$(sed -n 5p "$1/owner" 2>/dev/null)" = "$2" ]; then
            rm -rf "$1"
        fi
    ' "$lock" "$HUB_LOCK_NONCE" >/dev/null 2>&1 || \
        log WARN lock "could not release the hub lock at $lock - clear it by hand"
    log DEBUG lock "hub lock released"
}

# --------------------------------------------------------------------------
# Snapshots. Nothing is ever overwritten before the target is snapshotted,
# and rsync is only allowed --delete once that snapshot exists.
# --------------------------------------------------------------------------

# snapshot_local DIR -> echoes the snapshot path
#
# A snapshot that is quietly incomplete is worse than no snapshot, because
# --delete is gated on it existing. So the file count is asserted, not
# assumed, and the timestamp directory is created with a plain mkdir so two
# snapshots in the same second cannot merge into one.
snapshot_local() {
    local dir="$1" stamp snaproot snapdir src_n dst_n suffix
    snaproot="$(dirname "$dir")/$SNAP_DIRNAME"
    mkdir -p "$snaproot" || die $EX_SNAPSHOT snapshot \
        "could not create snapshot root $snaproot"

    stamp="$(iso_now)"
    snapdir="$snaproot/$stamp"
    suffix=2
    while ! mkdir "$snapdir" 2>/dev/null; do
        snapdir="$snaproot/$stamp-$suffix"
        suffix=$((suffix + 1))
        if [ "$suffix" -gt 50 ]; then
            die $EX_SNAPSHOT snapshot "could not create a unique snapshot directory under $snaproot"
        fi
    done

    # cpio will not extract through a symlinked parent (macOS /var and /tmp
    # are symlinks) and exits 0 having copied nothing, so resolve first.
    snapdir="$(cd "$snapdir" && pwd -P)"

    src_n="$(cd "$dir" && find . -type f ! -path "./$SNAP_DIRNAME/*" 2>/dev/null | grep -c . || true)"
    src_n="${src_n:-0}"

    if ! (cd "$dir" && find . -type f ! -path "./$SNAP_DIRNAME/*" -print0 2>/dev/null | \
          cpio -0 -pdm --quiet "$snapdir" 2>/dev/null); then
        log WARN snapshot "cpio path failed for $dir, falling back to cp -Rp"
        cp -Rp "$dir"/ "$snapdir"/ 2>/dev/null || die $EX_SNAPSHOT snapshot \
            "could not snapshot $dir into $snapdir"
    fi

    dst_n="$(find "$snapdir" -type f 2>/dev/null | grep -c . || true)"
    dst_n="${dst_n:-0}"
    if [ "$dst_n" -lt "$src_n" ]; then
        die $EX_SNAPSHOT snapshot \
            "snapshot of $dir is INCOMPLETE - $src_n files in the source, only $dst_n copied to $snapdir. Refusing to overwrite anything. Check permissions on $dir."
    fi

    prune_snapshots_local "$snaproot" "$dir"
    log INFO snapshot "local snapshot $snapdir ($dst_n files)"
    printf '%s' "$snapdir"
}

prune_snapshots_local() {
    local snaproot="$1" live="$2" keep="$CFG_SNAPSHOT_KEEP" n old
    [ "$keep" -gt 0 ] || return 0
    [ -d "$snaproot" ] || return 0

    # If the live directory is empty, the snapshots are the only copy left.
    # Pruning them on a schedule is how a recoverable mistake becomes a
    # permanent one, so refuse to prune at all in that state.
    if [ -d "$live" ]; then
        local livecount
        livecount="$(find "$live" -maxdepth 1 -type f 2>/dev/null | grep -c . || true)"
        if [ "${livecount:-0}" -eq 0 ]; then
            log WARN snapshot "live directory $live is empty - NOT pruning snapshots, they may be the only copy"
            return 0
        fi
    fi

    n="$(ls -1 "$snaproot" 2>/dev/null | grep -c . || true)"
    [ "${n:-0}" -le "$keep" ] && return 0
    ls -1 "$snaproot" | LC_ALL=C sort | head -n $((n - keep)) | while IFS= read -r old
    do
        if [ -n "$old" ]; then
            rm -rf "${snaproot:?}/$old"
            log INFO snapshot "pruned old snapshot $old"
        fi
    done
    return 0
}

# The hub twin of the above. The remote snippet sets its own pipefail: the
# script's is not inherited through ssh, and without it a find that dies
# partway (an unreadable directory) leaves cpio exiting 0 and a partial
# snapshot reported as a good one.
snapshot_hub() {
    local stamp snaproot snapdir out
    stamp="$(iso_now)"
    snaproot="$(dirname "$CFG_HUB_PATH")/$SNAP_DIRNAME"
    snapdir="$snaproot/$stamp"

    out="$(hub_exec_args '
        set -eo pipefail
        hub="$1"; snaproot="$2"; snapdir="$3"; stamp="$4"; keep="$5"
        snapdirs="$6"; lockdir="$7"
        mkdir -p "$snaproot"
        suffix=2
        while ! mkdir "$snapdir" 2>/dev/null; do
            snapdir="$snaproot/$stamp-$suffix"
            suffix=$((suffix + 1))
            [ "$suffix" -gt 50 ] && { echo STS_SNAP_NODIR; exit 1; }
        done
        snapdir=$(cd "$snapdir" && pwd -P)
        cd "$hub"
        src_n=$(find . -type f ! -path "./$snapdirs/*" 2>/dev/null | grep -c . || true)
        if ! find . -type f ! -path "./$snapdirs/*" -print0 2>/dev/null \
             | cpio -0 -pdm "$snapdir" 2>/dev/null; then
            cp -Rp "$hub"/ "$snapdir"/ 2>/dev/null || { echo STS_SNAP_FAIL; exit 1; }
        fi
        dst_n=$(find "$snapdir" -type f 2>/dev/null | grep -c . || true)
        if [ "${dst_n:-0}" -lt "${src_n:-0}" ]; then
            echo "STS_SNAP_SHORT $src_n $dst_n"
            exit 1
        fi
        livecount=$(find "$hub" -maxdepth 1 -type f 2>/dev/null | grep -c . || true)
        if [ "$keep" -gt 0 ] && [ "${livecount:-0}" -gt 0 ]; then
            n=$(ls -1 "$snaproot" 2>/dev/null | grep -c . || true)
            if [ "${n:-0}" -gt "$keep" ]; then
                ls -1 "$snaproot" | LC_ALL=C sort | head -n $((n - keep)) \
                  | while IFS= read -r old; do
                        [ -n "$old" ] || continue
                        rm -rf "$snaproot/$old"
                    done
            fi
        fi
        echo "STS_SNAP_OK $dst_n $snapdir"
    ' "$CFG_HUB_PATH" "$snaproot" "$snapdir" "$stamp" "$CFG_SNAPSHOT_KEEP" \
      "$SNAP_DIRNAME" "$LOCK_DIRNAME" 2>&1)" || true

    case "$out" in
        *STS_SNAP_OK*)
            log INFO snapshot "hub snapshot ok on $CFG_HUB_HOST: $(printf '%s' "$out" | tr '\n' ' ')" ;;
        *STS_SNAP_SHORT*)
            die $EX_SNAPSHOT snapshot \
                "hub snapshot is INCOMPLETE ($out) - refusing to overwrite the hub. Check permissions under $CFG_HUB_PATH on $CFG_HUB_HOST." ;;
        *)
            die $EX_SNAPSHOT snapshot \
                "could not snapshot the hub directory on $CFG_HUB_HOST into $snapdir: $out" ;;
    esac

    printf '%s' "$snapdir"
}

# --------------------------------------------------------------------------
# Transfer. rsync runs into a temp directory on the receiving side and is
# moved into place only after it exits 0, so a dropped connection leaves the
# target exactly as it was.
#
# Flags are deliberately just -a --delete plus excludes. No -E: it means
# --extended-attributes in openrsync but --executability in GNU rsync, and
# the only xattr these files carry is com.apple.provenance, which is local
# bookkeeping that should not cross machines.
# --------------------------------------------------------------------------

# NOTE: callers must expand this with globbing disabled - see run_rsync
# wrappers below, which set -f around the expansion.
rsync_excludes() {
    local out="--exclude=$SNAP_DIRNAME/ --exclude=$LOCK_DIRNAME/" name
    set -f
    for name in $CFG_SYNC_EXCLUDE; do
        out="$out --exclude=$name"
    done
    set +f
    printf '%s' "$out"
}

# run_rsync STEP ARGS... - surfaces rsync's own exit code and stderr intact.
run_rsync() {
    local step="$1"; shift
    local err_file out rc
    err_file="$(mktemp -t sts-rsync)"
    cleanup_later "$err_file"

    log INFO "$step" "rsync $*"
    set +e
    out="$(rsync "$@" 2>"$err_file")"
    rc=$?
    set -e

    local err
    err="$(cat "$err_file" 2>/dev/null || true)"
    [ -n "$out" ] && log DEBUG "$step" "rsync stdout: $(printf '%s' "$out" | tr '\n' '|')"
    [ -n "$err" ] && log DEBUG "$step" "rsync stderr: $(printf '%s' "$err" | tr '\n' '|')"

    if [ $rc -ne 0 ]; then
        case "$err$out" in
            *"No space left on device"*|*"write error"*|*"disk full"*)
                log ERROR "$step" "disk full (rsync rc=$rc): $err"
                printf 'error: out of disk space during transfer.\n' >&2
                printf 'rsync exit code %s, stderr:\n%s\n' "$rc" "$err" >&2
                printf 'Check free space on both sides:\n' >&2
                printf '  local: df -h %s\n' "$CFG_LOCAL_SAVE_PATH" >&2
                if [ -n "$HUB_ENDPOINT" ]; then
                    printf '  hub:   %s df -h %s\n' "$(ssh_repro_cmd)" "$CFG_HUB_PATH" >&2
                else
                    printf '  hub:   df -h %s\n' "$CFG_HUB_PATH" >&2
                fi
                exit $EX_DISK_FULL ;;
        esac
        log ERROR "$step" "rsync failed rc=$rc: $err"
        printf 'error: rsync failed with its own exit code %s.\n' "$rc" >&2
        printf 'rsync stderr:\n%s\n' "$err" >&2
        printf 'The target was not modified - the transfer ran into a temp directory.\n' >&2
        exit $EX_RSYNC
    fi
    printf '%s' "$out"
}

# Files in SYNC_EXCLUDE are machine-local by definition: they are never
# transferred in either direction. But a transfer stages into a temp
# directory and swaps that whole directory into place, so anything not
# transferred is simply absent from the replacement - which silently
# deleted the receiver's own copy. They must be carried across by hand.
preserve_excluded() {
    local live="$1" staged="$2" name f count=0
    [ -d "$live" ] || return 0
    set -f
    for name in $CFG_SYNC_EXCLUDE; do
        set +f
        for f in "$live"/$name; do
            if [ -e "$f" ] && [ ! -e "$staged/$(basename "$f")" ]; then
                if cp -Rp "$f" "$staged"/ 2>/dev/null; then
                    count=$((count + 1))
                else
                    log ERROR preserve "could not carry excluded path $f into $staged"
                    die $EX_SNAPSHOT preserve \
                        "failed to preserve the excluded path $f - refusing to swap, because the swap would delete it"
                fi
            fi
        done
        set -f
    done
    set +f
    if [ "$count" -gt 0 ]; then
        log INFO preserve "carried $count excluded file(s) across the swap into $staged"
    fi
    return 0
}

preserve_excluded_hub() {
    local staged="$1" name
    [ -n "$CFG_SYNC_EXCLUDE" ] || return 0
    # Build a positional list the way manifest_hub does, rather than joining
    # into a string. A string has to be expanded unquoted at the call site,
    # and by then set -f is off again, so a SYNC_EXCLUDE entry containing a
    # glob would expand against whatever directory sts was invoked from.
    set --
    set -f
    for name in $CFG_SYNC_EXCLUDE; do set -- "$@" "$name"; done
    set +f
    hub_exec_args '
        hub="$1"; staged="$2"; shift 2
        cd "$hub" 2>/dev/null || exit 0
        for n in "$@"; do
            set -f
            for f in $n; do
                set +f
                [ -e "$f" ] || continue
                [ -e "$staged/$f" ] && continue
                cp -Rp "$f" "$staged"/ 2>/dev/null || true
            done
            set +f
        done
    ' "$CFG_HUB_PATH" "$staged" "$@" >/dev/null 2>&1 || true
    return 0
}

# pull_hub_to_local - hub becomes local. Snapshot first, temp dir, then swap.
pull_hub_to_local() {
    local target="$1" tmp src
    tmp="$(dirname "$target")/.sts-incoming-$$"
    cleanup_later "$tmp"
    rm -rf "$tmp"; mkdir -p "$tmp"

    if [ "$IS_HUB" -eq 1 ]; then
        src="$CFG_HUB_PATH/"
    else
        src="$(ssh_target):$CFG_HUB_PATH/"
    fi

    # The snapshot is what makes --delete safe. No snapshot, no --delete.
    local snap
    snap="$(snapshot_local "$target")"
    say "snapshot: $snap"

    if [ "$IS_HUB" -eq 1 ]; then
        set -f
        run_rsync pull -a --delete $(rsync_excludes) \
            --link-dest="$target" "$src" "$tmp/" >/dev/null
        set +f
    else
        set -f
        run_rsync pull -a --delete $(rsync_excludes) \
            --link-dest="$target" -e "ssh $(ssh_opts)" "$src" "$tmp/" >/dev/null
        set +f
    fi

    preserve_excluded "$target" "$tmp"
    swap_into_place "$tmp" "$target"
    log INFO pull "hub -> local complete"
}

# push_local_to_hub - local becomes hub. Same shape, temp dir lives on the hub.
push_local_to_hub() {
    local src="$1" tmp dst
    tmp="$(dirname "$CFG_HUB_PATH")/.sts-incoming-$$"

    # Sweep staging directories left by interrupted pushes. Safe here: we
    # hold the hub lock, so nothing else is mid-transfer.
    hub_exec_args '
        parent="$1"
        now=$(date -u +%s)
        for d in "$parent"/.sts-incoming-*; do
            [ -d "$d" ] || continue
            m=$(stat -f%m "$d" 2>/dev/null || echo "$now")
            [ $((now - m)) -ge 300 ] && rm -rf "$d"
        done
        exit 0
    ' "$(dirname "$CFG_HUB_PATH")" >/dev/null 2>&1 || true

    hub_exec_args 'rm -rf "$1" && mkdir -p "$1"' "$tmp" || die $EX_HUB_PERMS push \
        "could not create the staging directory $tmp on $CFG_HUB_HOST"

    local snap
    snap="$(snapshot_hub)"
    say "snapshot: $snap (on $CFG_HUB_HOST)"

    if [ "$IS_HUB" -eq 1 ]; then
        set -f
        run_rsync push -a --delete $(rsync_excludes) \
            --link-dest="$CFG_HUB_PATH" "$src/" "$tmp/" >/dev/null
        set +f
        preserve_excluded "$CFG_HUB_PATH" "$tmp"
        swap_into_place "$tmp" "$CFG_HUB_PATH"
    else
        dst="$(ssh_target):$tmp/"
        set -f
        run_rsync push -a --delete $(rsync_excludes) \
            --link-dest="$CFG_HUB_PATH" -e "ssh $(ssh_opts)" "$src/" "$dst" >/dev/null
        set +f
        preserve_excluded_hub "$tmp"
        IN_SWAP=1
        hub_exec_args '
            set -e
            trap "" HUP INT TERM
            hub="$1"; tmp="$2"; old="$1.sts-old-$3"
            rm -rf "$old"
            mv "$hub" "$old"
            if ! mv "$tmp" "$hub"; then
                mv "$old" "$hub"
                exit 90
            fi
            rm -rf "$old"
        ' "$CFG_HUB_PATH" "$tmp" "$$" || die $EX_HUB_PERMS push \
            "transfer succeeded but moving it into place on $CFG_HUB_HOST failed - the previous hub content was restored, or is at $CFG_HUB_PATH.sts-old-$$"
        IN_SWAP=0
    fi
    log INFO push "local -> hub complete"
}

# The move is the only moment the target is not intact, and it is two renames.
swap_into_place() {
    local tmp="$1" target="$2" old
    old="$target.sts-old-$$"
    rm -rf "$old"
    mv "$target" "$old" || die $EX_RSYNC swap \
        "could not move $target aside - nothing was changed"
    IN_SWAP=1
    if ! mv "$tmp" "$target"; then
        mv "$old" "$target"
        IN_SWAP=0
        die $EX_RSYNC swap \
            "could not move the staged copy into place - the original was restored"
    fi
    IN_SWAP=0
    rm -rf "$old"
    log DEBUG swap "$tmp -> $target"
}

# --------------------------------------------------------------------------
# Per-machine state. A missing or corrupt state file means first run. It
# never means "nothing changed".
# --------------------------------------------------------------------------

state_read() {
    [ -f "$STATE_FILE" ] || { printf 'FIRSTRUN'; return 0; }
    python3 - "$STATE_FILE" "$CFG_HUB_HOST" "$CFG_HUB_PATH" <<'PY' 2>/dev/null || printf 'FIRSTRUN'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    if d.get("version") != 2:
        raise ValueError("version")
    # State recorded against a different hub says nothing about this one.
    if d.get("hub_host") != sys.argv[2] or d.get("hub_path") != sys.argv[3]:
        raise ValueError("hub changed")
    print("%s\t%s\t%s\t%s" % (d["direction"], d["epoch"],
                              d["local_fingerprint"], d["hub_fingerprint"]))
except Exception:
    raise SystemExit(1)
PY
}

state_write() {
    local direction="$1" lfp="$2" hfp="$3"
    mkdir -p "$STATE_DIR"
    python3 - "$STATE_FILE" "$direction" "$lfp" "$hfp" "$(iso_now)" \
             "$CFG_HUB_HOST" "$CFG_HUB_PATH" <<'PY'
import json, sys, time, os
path, direction, lfp, hfp, iso, hub_host, hub_path = sys.argv[1:8]
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump({"version": 2, "direction": direction, "timestamp": iso,
               "epoch": int(time.time()), "local_fingerprint": lfp,
               "hub_fingerprint": hfp, "hub_host": hub_host,
               "hub_path": hub_path}, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
PY
    log INFO state "recorded $direction local=$(printf '%s' "$lfp" | cut -c1-12) hub=$(printf '%s' "$hfp" | cut -c1-12)"
}

# --------------------------------------------------------------------------
# Conflict detection. Nothing is ever merged and nothing is ever auto-picked.
# When both sides moved, both sides are described and the run stops.
# --------------------------------------------------------------------------

check_game_not_running() {
    local pids
    pids="$(pgrep -x "$CFG_GAME_PROCESS_NAME" 2>/dev/null || true)"
    if [ -n "$pids" ]; then
        die $EX_GAME_RUNNING game \
            "$CFG_GAME_PROCESS_NAME is running (pid $(printf '%s' "$pids" | tr '\n' ' ')) - it holds core.db open read-write, so any copy taken now would be torn. Quit the game first."
    fi
}

# Clock skew makes mtimes untrustworthy. Fingerprints do not care, so this
# warns rather than fails, and says which comparison is being relied on.
check_clock_skew() {
    [ "$IS_HUB" -eq 1 ] && return 0
    local hub_epoch now diff
    hub_epoch="$(hub_clock_epoch 2>/dev/null || echo 0)"
    case "$hub_epoch" in ''|*[!0-9]*) return 0 ;; esac
    now="$(date -u +%s)"
    diff=$((hub_epoch - now))
    [ "$diff" -lt 0 ] && diff=$((-diff))
    if [ "$diff" -gt "$CFG_CLOCK_SKEW_TOLERANCE" ]; then
        log WARN clock "hub clock differs by ${diff}s (tolerance ${CFG_CLOCK_SKEW_TOLERANCE}s)"
        warn "the hub's clock is ${diff}s away from this machine's - timestamps below are unreliable, the decision is based on content fingerprints"
    else
        log DEBUG clock "hub clock skew ${diff}s, within tolerance"
    fi
}

human_time() {
    local epoch="$1"
    [ "${epoch:-0}" -gt 0 ] || { printf 'never'; return 0; }
    date -r "$epoch" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || printf '%s' "$epoch"
}

# describe_side LABEL MANIFEST NEWEST_EPOCH
describe_side() {
    local label="$1" manifest="$2" epoch="$3"
    local total saves newest_save
    total="$(printf '%s' "$manifest" | grep -c . || true)"
    saves="$(printf '%s' "$manifest" | grep -c 'game_[0-9]*\.db$' || true)"
    printf '  %s\n' "$label"
    printf '    files:     %s (%s campaign saves)\n' "${total:-0}" "${saves:-0}"
    printf '    newest:    %s\n' "$(human_time "$epoch")"
    newest_save="$(printf '%s' "$manifest" | grep 'game_[0-9]*\.db$' | awk '{print $3}' | tr '\n' ' ' || true)"
    if [ -n "$newest_save" ]; then
        printf '    campaigns: %s\n' "$newest_save"
    fi
    return 0
}

conflict_report() {
    local reason="$1" lman="$2" hman="$3" lep="$4" hep="$5"
    printf 'error: %s\n' "$reason" >&2
    printf '\n' >&2
    describe_side "LOCAL  ($(this_host_id)): $CFG_LOCAL_SAVE_PATH" "$lman" "$lep" >&2
    printf '\n' >&2
    describe_side "HUB    ($CFG_HUB_HOST): $CFG_HUB_PATH" "$hman" "$hep" >&2
    printf '\n' >&2
    printf 'These are not merged and not auto-picked. Decide, then run:\n' >&2
    printf '  %s push --force=local   keep this machine'"'"'s saves, overwrite the hub\n' "$PROG" >&2
    printf '  %s pull --force=hub     keep the hub'"'"'s saves, overwrite this machine\n' "$PROG" >&2
    printf '\nBoth sides are snapshotted before any overwrite, under %s/\n' "$SNAP_DIRNAME" >&2
}

# --------------------------------------------------------------------------
# sts doctor
#
# Everything else in this script aborts on the first problem, which makes
# setting up a machine a loop: fix one thing, re-run, discover the next.
# doctor runs every check, aborts on none, and prints one report.
#
# Two rules it does not break:
#   - read-only unless --fix is given
#   - --fix only does things that are safe, reversible and idempotent. It
#     never accepts a host key, changes system settings, or grants
#     permissions. Those it explains and hands back to you.
# --------------------------------------------------------------------------

DOC_FAIL=0
DOC_WARN=0
DOC_FIXED=0
DOC_SKIP=0
DOC_FIXABLE=0        # problems --fix could actually repair

doc_section() { printf '\n  %s\n' "$1"; }
doc_ok()   { printf '    ok    %s\n' "$*"; }
doc_note() { printf '    note  %s\n' "$*"; }
doc_warn() { DOC_WARN=$((DOC_WARN + 1)); printf '    warn  %s\n' "$*"; }
doc_fail() { DOC_FAIL=$((DOC_FAIL + 1)); printf '    FAIL  %s\n' "$*"; }
doc_fixed(){ DOC_FIXED=$((DOC_FIXED + 1)); printf '    fixed %s\n' "$*"; }
doc_skip() {
    DOC_SKIP=$((DOC_SKIP + 1))
    printf '    --    skipped, needs: %s\n' "$*"
}
# The indented remediation under a failure.
doc_do()   { printf '          %s\n' "$*"; }

# doc_try DESCRIPTION COMMAND... - run a repair only under --fix.
# Prints what it would do otherwise, so a dry doctor still teaches.
doc_try() {
    local what="$1"; shift
    if [ "$OPT_FIX" -eq 1 ]; then
        if "$@" >/dev/null 2>&1; then
            doc_fixed "$what"
            return 0
        fi
        doc_fail "could not $what"
        return 1
    fi
    DOC_FIXABLE=$((DOC_FIXABLE + 1))
    doc_do "sts doctor --fix   will: $what"
    return 1
}

# --------------------------------------------------------------------------

doc_environment() {
    doc_section "environment"

    if [ "$(id -u)" -eq 0 ]; then
        doc_fail "running as root"
        doc_do "run as your normal user; root would leave files you cannot rewrite"
    else
        doc_ok "running as $(whoami), not root"
    fi

    local maj min
    maj="${BASH_VERSINFO[0]}"; min="${BASH_VERSINFO[1]}"
    if [ "$maj" -lt 3 ] || { [ "$maj" -eq 3 ] && [ "$min" -lt 2 ]; }; then
        doc_fail "bash $BASH_VERSION is too old, 3.2 required"
    else
        doc_ok "bash $maj.$min"
    fi

    local t missing=""
    for t in rsync ssh python3 shasum cpio; do
        command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
    done
    if [ -n "$missing" ]; then
        doc_fail "not on PATH:$missing"
        doc_do "these ship with macOS; python3 needs the Xcode command line tools:"
        doc_do "    xcode-select --install"
    else
        doc_ok "rsync, ssh, python3, shasum, cpio"
        case "$(rsync --version 2>&1 | head -1)" in
            *openrsync*) doc_note "rsync is openrsync (macOS built-in)" ;;
        esac
    fi

    # ~/bin on PATH. Appending one line to a shell rc is reversible and
    # idempotent, so --fix will do it - but it shows the exact line first
    # and keeps a backup, because silently editing someone's shell config
    # is how installers earn their reputation.
    case ":$PATH:" in
        *":$HOME/bin:"*) doc_ok "~/bin is on PATH" ;;
        *)
            # Distinguish "never configured" from "configured, but this
            # shell started before it" - otherwise doctor tells you to add
            # a line that is already there.
            if [ -f "$HOME/.zshrc" ] && grep -qF 'HOME/bin' "$HOME/.zshrc" 2>/dev/null; then
                doc_warn "~/bin is in ~/.zshrc but not in this shell's PATH"
                doc_do "this shell started before the line was added. Open a new one, or:"
                doc_do "    exec zsh"
            else
                doc_warn "~/bin is not on PATH, so 'sts' will not resolve"
                if [ "$OPT_FIX" -eq 1 ]; then
                    doc_fix_path || true
                else
                    DOC_FIXABLE=$((DOC_FIXABLE + 1))
                    doc_do "sts doctor --fix   will append to ~/.zshrc (with a backup):"
                    doc_do "    export PATH=\"\$HOME/bin:\$PATH\""
                fi
            fi ;;
    esac

    if [ -L "$HOME/bin/sts" ]; then
        local tgt
        tgt="$(readlink "$HOME/bin/sts" || true)"
        if [ -x "$tgt" ]; then
            doc_ok "sts -> $tgt"
        else
            doc_fail "~/bin/sts points at $tgt, which is missing or not executable"
            doc_do "re-run ./install.sh from the repository"
        fi
    elif [ -e "$HOME/bin/sts" ]; then
        doc_warn "~/bin/sts exists but is not a symlink; install.sh will not touch it"
    else
        doc_warn "sts is not installed in ~/bin"
        doc_do "run ./install.sh from the repository"
    fi
}

doc_fix_path() {
    local rc="$HOME/.zshrc" line='export PATH="$HOME/bin:$PATH"'
    if [ -f "$rc" ] && grep -qF 'HOME/bin' "$rc" 2>/dev/null; then
        doc_note "~/.zshrc already mentions ~/bin; not adding it twice"
        doc_do "open a new shell, or: export PATH=\"\$HOME/bin:\$PATH\""
        return 0
    fi
    [ -f "$rc" ] && cp "$rc" "$rc.sts-backup" 2>/dev/null
    {
        printf '\n# star-traders-sync: sts and star-traders-sync live in ~/bin\n'
        printf '%s\n' "$line"
    } >> "$rc" 2>/dev/null || { doc_fail "could not write $rc"; return 1; }
    doc_fixed "appended to ~/.zshrc (backup at ~/.zshrc.sts-backup)"
    doc_do "open a new shell, or: exec zsh"
}

# Returns 0 when the config is present and usable. Unlike load_config it
# reports every problem instead of dying on the first, and it never exits -
# doctor has to keep going and check the rest.
DOC_CONFIG_OK=0

doc_config() {
    doc_section "config"

    if [ ! -e "$CONFIG_FILE" ]; then
        doc_fail "no config at $CONFIG_FILE"
        doc_do "run ./install.sh from the repository, which writes a starting one"
        return 1
    fi
    if [ ! -r "$CONFIG_FILE" ]; then
        doc_fail "$CONFIG_FILE is not readable by $(whoami)"
        return 1
    fi
    doc_ok "$CONFIG_FILE"

    # Ask the real parser whether it would succeed, in a subshell where its
    # die() ends only that subshell. A hand-rolled mirror of load_config's
    # checks would silently drift the moment load_config gained a rule, and
    # doctor would regain the truncated-report bug for good.
    local lerr lrc
    set +e
    lerr="$( load_config 2>&1 )"
    lrc=$?
    set -e
    if [ $lrc -ne 0 ]; then
        doc_fail "config cannot be parsed"
        printf '%s\n' "$lerr" | grep -v '^exit code' | sed 's/^error: //' \
            | while IFS= read -r l; do [ -n "$l" ] && doc_do "$l"; done
        doc_do "the file is parsed, not sourced - no shell syntax, see config.example"
        return 1
    fi
    # It parses, so this cannot die.
    load_config

    # Placeholders are the single most common half-finished install.
    local k v placeholders=""
    for k in HUB_HOST HUB_USER HUB_PATH BACKUP_VOLUME BACKUP_DEST; do
        eval "v=\${CFG_$k}"
        case "$v" in
            *my-mac-mini*|*my-macbook*|*youruser*|*YourDisk*|*tailnet-name*|/Volumes/Backup*)
                placeholders="$placeholders $k" ;;
        esac
    done
    if [ -n "$placeholders" ]; then
        doc_fail "still set to the example placeholders:$placeholders"
        doc_do "edit $CONFIG_FILE"
        doc_do "HUB_HOST is the tailscale node name of the machine hosting the hub"
        doc_do "  see: tailscale status"
        doc_do "HUB_USER is your account name ON THAT machine"
        return 1
    fi

    local missing=""
    for k in HUB_HOST HUB_USER HUB_PATH LOCAL_SAVE_PATH STEAM_APPID \
             GAME_PROCESS_NAME BACKUP_VOLUME BACKUP_DEST; do
        eval "v=\${CFG_$k}"
        [ -n "$v" ] || missing="$missing $k"
    done
    if [ -n "$missing" ]; then
        doc_fail "required keys missing or empty:$missing"
        doc_do "edit $CONFIG_FILE"
        return 1
    fi
    doc_ok "all required keys set"

    # The real validator, not a hand-rolled subset. die() inside $( ) only
    # ends the subshell, so doctor gets the message and keeps going.
    # Reimplementing these checks is what let the nesting rule - the one
    # that stops a push moving the live save directory out from under the
    # game - go unchecked here in the first place.
    local verr vrc
    set +e
    verr="$( validate_config 2>&1 )"
    vrc=$?
    set -e
    if [ $vrc -ne 0 ]; then
        doc_fail "config is not valid"
        printf '%s\n' "$verr" | grep -v '^exit code' | sed 's/^error: //' \
            | while IFS= read -r l; do [ -n "$l" ] && doc_do "$l"; done
        return 1
    fi
    doc_ok "config passes every validation rule"

    DOC_CONFIG_OK=1
    return 0
}

doc_state_dirs() {
    doc_section "state and logs"
    local d
    for d in "$CONFIG_DIR" "$STATE_DIR" "$LOG_DIR"; do
        if [ -d "$d" ] && [ -w "$d" ]; then
            doc_ok "$d"
        elif [ -e "$d" ]; then
            doc_fail "$d exists but is not a writable directory"
        else
            if ! doc_try "create $d" mkdir -p "$d"; then
                doc_warn "$d does not exist yet"
            fi
        fi
    done

    # A leaked local lock is the one thing that wedges every later run, and
    # it is trivially safe to clear once its owner is gone.
    local lockdir="$STATE_DIR/local.lock.d" holder
    if [ -d "$lockdir" ]; then
        holder="$(cat "$STATE_DIR/local.lock" 2>/dev/null || true)"
        case "$holder" in ''|*[!0-9]*) holder="" ;; esac
        if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
            doc_note "another sts is running right now (pid $holder)"
        else
            doc_warn "a stale local lock is present (owner ${holder:-unknown} is gone)"
            doc_try "clear the stale local lock" rm -rf "$lockdir" "$STATE_DIR/local.lock" || true
        fi
    else
        doc_ok "no stale local lock"
    fi
}

doc_save_dir() {
    doc_section "game"
    local p="$CFG_LOCAL_SAVE_PATH"

    if [ ! -e "$p" ]; then
        doc_fail "save directory does not exist: $p"
        doc_do "launch the game once so it creates it, then re-run"
        doc_do "if the path is wrong, find the real one:"
        doc_do "    ls -la ~/Library | grep -i star"
        return 1
    fi
    if [ ! -d "$p" ]; then
        doc_fail "$p is not a directory"
        return 1
    fi

    local count
    count="$(find "$p" -maxdepth 1 -type f 2>/dev/null | grep -c . || true)"
    if [ "${count:-0}" -eq 0 ]; then
        doc_warn "save directory is empty: $p"
        doc_do "launch the game once, or check the path is right"
    else
        doc_ok "save directory, ${count} files"
    fi

    # The appid is checkable without launching anything.
    local found=0 lib
    for lib in "$HOME/Library/Application Support/Steam" /Volumes/*/SteamLibrary; do
        [ -f "$lib/steamapps/appmanifest_$CFG_STEAM_APPID.acf" ] && found=1 && break
    done
    if [ "$found" -eq 1 ]; then
        doc_ok "Steam appid $CFG_STEAM_APPID is installed"
    else
        doc_warn "no Steam manifest found for appid $CFG_STEAM_APPID"
        doc_do "sts play needs it; pull and push do not"
        doc_do "check with: open steam://rungameid/$CFG_STEAM_APPID"
    fi
    return 0
}

DOC_TS_OK=0
DOC_IS_HUB=0

# Is a sync in progress on the hub right now?
#
# doctor takes no locks - it is meant to be safe to run at any moment - but
# that means --fix must not create HUB_PATH while a swap has it renamed
# aside. push_local_to_hub and swap_into_place both leave that path briefly
# absent, and recreating it there turns the in-flight `mv staged hub` into a
# move INTO the new empty directory rather than a replacement. mv exits 0,
# the swap's own check sees success, and the pre-swap copy is then deleted.
hub_is_busy() {
    local lock; lock="$(hub_lock_path)"
    if [ "$DOC_IS_HUB" -eq 1 ]; then
        [ -d "$lock" ]
    else
        hub_exec_args '[ -d "$1" ]' "$lock" >/dev/null 2>&1
    fi
}

doc_tailscale() {
    doc_section "tailscale"

    if [ -x "$TS_APP_PATH" ]; then
        TS_BIN="$TS_APP_PATH"; doc_ok "found the App Store app"
    elif command -v tailscale >/dev/null 2>&1; then
        TS_BIN="$(command -v tailscale)"; doc_ok "found $TS_BIN"
    else
        doc_fail "tailscale is not installed"
        doc_do "install the Tailscale app from the App Store, or: brew install tailscale"
        return 1
    fi

    local json state
    json="$("$TS_BIN" status --json 2>&1)" || {
        doc_fail "tailscaled is not running"
        doc_do "start the Tailscale app, or: sudo tailscaled install-system-daemon"
        return 1
    }
    state="$(printf '%s' "$json" | python3 -c \
        'import json,sys;print(json.load(sys.stdin).get("BackendState",""))' 2>/dev/null || true)"
    if [ -z "$state" ]; then
        doc_fail "could not read tailscale status - the output was not valid JSON"
        doc_do "check it by hand: $TS_BIN status --json | head -3"
        return 1
    fi
    if [ "$state" != "Running" ]; then
        doc_fail "tailscale is $state, not Running"
        doc_do "log in:  $TS_BIN up"
        doc_do "this is interactive and opens a browser, so doctor will not do it for you"
        return 1
    fi

    local self
    self="$(printf '%s' "$json" | python3 -c \
        'import json,sys;print((json.load(sys.stdin).get("Self",{}).get("HostName") or ""))' 2>/dev/null || true)"
    if [ -z "$self" ]; then
        doc_fail "tailscale is running but did not report this machine's name"
        return 1
    fi
    doc_ok "running, this machine is '$self'"

    # Is this the hub? Uses the same comparison every other command uses,
    # so doctor cannot reach a different verdict than push and pull do.
    local self_dns
    self_dns="$(printf '%s' "$json" | python3 -c \
        'import json,sys;print((json.load(sys.stdin).get("Self",{}).get("DNSName") or "").rstrip(".").split(".")[0])' 2>/dev/null || true)"
    if hub_host_matches "$self" "$self_dns"; then
        DOC_IS_HUB=1
        IS_HUB=1
        doc_ok "this machine IS the hub, so no ssh is involved"
        DOC_TS_OK=1
        return 0
    fi

    local peer
    peer="$(ts_find_peer "$json" "$CFG_HUB_HOST" || true)"
    if [ -z "$peer" ]; then
        doc_fail "hub '$CFG_HUB_HOST' is not in this tailnet at all"
        doc_do "check HUB_HOST against the node names in:"
        doc_do "    $TS_BIN status"
        doc_do "both machines must be on the SAME tailnet; Apple IDs are irrelevant"
        return 1
    fi

    HUB_DNS="$(printf '%s' "$peer" | cut -f1)"
    HUB_IP="$(printf '%s' "$peer" | cut -f2)"
    local online; online="$(printf '%s' "$peer" | cut -f3)"

    if [ "$online" != "1" ]; then
        doc_fail "hub '$CFG_HUB_HOST' is in the tailnet but offline"
        doc_do "wake it, or check Tailscale is running there"
        return 1
    fi
    doc_ok "hub '$CFG_HUB_HOST' is online at $HUB_IP"

    if [ -n "$HUB_DNS" ] && ping -c1 -t2 "$HUB_DNS" >/dev/null 2>&1; then
        HUB_ENDPOINT="$HUB_DNS"; HUB_ENDPOINT_KIND="magicdns"
        doc_ok "MagicDNS resolves: $HUB_DNS"
    else
        HUB_ENDPOINT="$HUB_IP"; HUB_ENDPOINT_KIND="tailnet-ip"
        doc_note "MagicDNS does not resolve here, using the tailnet IP $HUB_IP"
        doc_note "normal when tailscaled came from Homebrew; not a problem"
    fi

    if "$TS_BIN" ping --c 2 --timeout 5s "$HUB_IP" >/dev/null 2>&1; then
        doc_ok "tailscale ping reaches the hub"
    else
        doc_fail "hub says online but tailscale ping fails"
        doc_do "    $TS_BIN ping $HUB_IP"
        return 1
    fi

    DOC_TS_OK=1
    return 0
}

doc_ssh() {
    doc_section "ssh to the hub"

    if [ "$DOC_IS_HUB" -eq 1 ]; then
        doc_ok "not needed, this machine is the hub"
        return 0
    fi
    if [ "$DOC_TS_OK" -eq 0 ]; then
        doc_skip "a reachable hub"
        return 1
    fi

    local key="$HOME/.ssh/id_ed25519"
    if [ -f "$key" ]; then
        doc_ok "ssh key $key"
    else
        doc_warn "no ssh key at $key"
        if ! doc_try "generate an ssh key" ssh-keygen -t ed25519 -N "" -C "sts@$(hostname -s)" -f "$key"; then
            doc_do "or by hand: ssh-keygen -t ed25519 -C \"sts@$(hostname -s)\""
            return 1
        fi
    fi

    # Host key. Never accepted automatically - but if the same machine is
    # already trusted under its other address, that is a comparison we can
    # do for the user instead of making them eyeball two hashes.
    if ssh-keygen -F "$HUB_ENDPOINT" >/dev/null 2>&1; then
        doc_ok "host key for $HUB_ENDPOINT is trusted"
    else
        doc_fail "host key for $HUB_ENDPOINT is not trusted yet"
        hostkey_help "$HUB_ENDPOINT" 2>&1 | sed 's/^/          /'
        doc_skip "a trusted host key"
        return 1
    fi

    local out rc
    set +e
    # shellcheck disable=SC2086
    out="$(ssh $(ssh_opts) "$(ssh_target)" 'echo STS_OK' 2>&1)"
    rc=$?
    set -e
    if [ $rc -eq 0 ] && [ "$out" = "STS_OK" ]; then
        doc_ok "key auth works: $(ssh_target)"
    else
        doc_fail "cannot ssh to the hub without a password"
        case "$out" in
            *"Permission denied"*)
                doc_do "your key is not on the hub yet. Run, and enter the HUB's password:"
                doc_do "    ssh-copy-id -i $HOME/.ssh/id_ed25519.pub $(ssh_target)"
                doc_do "doctor will not do this: it needs a password it must not handle" ;;
            *"Connection refused"*)
                doc_do "Remote Login is off on the hub. On the hub:"
                doc_do "    System Settings > General > Sharing > Remote Login"
                doc_do "then check your user is allowed:"
                doc_do "    dseditgroup -o checkmember -m $CFG_HUB_USER com.apple.access_ssh" ;;
            *)
                doc_do "ssh said: $(printf '%s' "$out" | head -1)"
                doc_do "reproduce it by hand: $(ssh_repro_cmd)" ;;
        esac
        doc_skip "working ssh"
        return 1
    fi

    # Hub directory. Guarded like every other risky substitution here: this
    # runs ssh, and a connection that drops between the auth probe above and
    # this line would otherwise kill the whole report - on a machine already
    # having connectivity trouble, which is exactly when doctor is run.
    local probe prc
    set +e
    probe="$(hub_exec_args '
        d="$1"
        [ -e "$d" ] || { echo NOENT; exit 0; }
        [ -d "$d" ] || { echo NOTDIR; exit 0; }
        [ -w "$d" ] || { echo NOWRITE; exit 0; }
        echo OK
    ' "$CFG_HUB_PATH" 2>&1)"
    prc=$?
    set -e
    if [ $prc -ne 0 ]; then
        doc_fail "lost the connection while probing the hub directory"
        doc_do "$(printf '%s' "$probe" | head -1)"
        doc_do "re-run when the hub is reachable: $(ssh_repro_cmd)"
        return 1
    fi
    case "$probe" in
        *OK*)      doc_ok "hub directory $CFG_HUB_PATH is writable" ;;
        *NOENT*)
            doc_warn "hub directory does not exist yet: $CFG_HUB_PATH"
            if hub_is_busy; then
                doc_do "a sync is running on the hub right now - not creating it"
                doc_do "re-run once that finishes"
            else
                doc_try "create $CFG_HUB_PATH on $CFG_HUB_HOST" \
                    hub_exec_args 'mkdir -p "$1"' "$CFG_HUB_PATH" \
                    || doc_do "or seed it: sts push --force=local"
            fi ;;
        *NOTDIR*)  doc_fail "$CFG_HUB_PATH exists on the hub but is not a directory" ;;
        *NOWRITE*) doc_fail "$CFG_HUB_USER cannot write $CFG_HUB_PATH on the hub" ;;
        *)         doc_fail "could not probe the hub directory: $probe" ;;
    esac
    return 0
}

doc_hub_only() {
    [ "$DOC_IS_HUB" -eq 1 ] || return 0
    doc_section "hub duties (this machine)"

    if [ -d "$CFG_HUB_PATH" ]; then
        local n
        n="$(find "$CFG_HUB_PATH" -maxdepth 1 -type f 2>/dev/null | grep -c . || true)"
        doc_ok "hub directory, ${n:-0} files"
    elif hub_is_busy; then
        doc_warn "hub directory does not exist yet: $CFG_HUB_PATH"
        doc_do "a sync is running right now, which moves it aside briefly"
        doc_do "not creating it - that would turn the in-flight swap into a nested move"
        doc_do "re-run once the sync finishes"
    else
        doc_warn "hub directory does not exist yet: $CFG_HUB_PATH"
        doc_try "create $CFG_HUB_PATH" mkdir -p "$CFG_HUB_PATH" \
            || doc_do "or seed it from the machine holding the saves: sts push --force=local"
    fi

    if backup_volume_mounted; then
        doc_ok "backup volume $CFG_BACKUP_VOLUME is mounted and writable"
        case "$(diskutil info "$CFG_BACKUP_VOLUME" 2>/dev/null | grep 'File System Personality' | awk '{print $NF}')" in
            ExFAT|MS-DOS|FAT32)
                doc_note "the backup volume has no hard links, so each backup is a full copy" ;;
        esac
    else
        doc_warn "backup volume $CFG_BACKUP_VOLUME is not mounted"
        doc_do "plug the disk in; sts backup refuses rather than writing to the internal disk"
    fi

    local label="com.github.moudlajs.star-traders-sync.backup"
    if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
        local ec
        ec="$(launchctl print "gui/$(id -u)/$label" 2>/dev/null | grep -oE 'last exit code = [0-9]+' | grep -oE '[0-9]+$' || true)"
        if [ -z "$ec" ]; then
            doc_ok "daily backup job is loaded, has not run yet"
            doc_do "run it now to be sure it works: launchctl kickstart -k gui/$(id -u)/$label"
        elif [ "$ec" = "0" ]; then
            doc_ok "daily backup job is loaded, last run exited 0"
        else
            doc_warn "daily backup job is loaded, last run exited $ec"
            doc_do "see ~/Library/Logs/star-traders-sync/backup.launchd.err"
            [ "${ec:-0}" = "70" ] && doc_do "exit 70 usually means the disk was unplugged, or macOS denied access to it"
        fi
    else
        doc_warn "the daily backup job is not installed"
        doc_do "./launchd/install-backup-job.sh"
    fi
    return 0
}

cmd_doctor() {
    printf '%s %s - checking this machine\n' "$PROG" "$STS_VERSION"
    [ "$OPT_FIX" -eq 1 ] && printf '(--fix: safe repairs will be applied)\n'

    # Every one of these returns non-zero for ordinary states - no save
    # directory yet, no ssh yet. Under set -e a bare call aborts the whole
    # report at the first problem, which is the one thing doctor exists not
    # to do. The || true is load-bearing, not defensive noise.
    doc_environment || true

    if doc_config; then
        doc_state_dirs || true
        doc_save_dir || true
        if doc_tailscale; then
            doc_ssh || true
            doc_hub_only || true
        else
            doc_section "ssh to the hub"; doc_skip "a working tailscale"
        fi
    else
        doc_section "everything else"
        doc_skip "a valid config"
        printf '    --    nothing else can be checked until the config is right\n'
    fi

    printf '\n'
    if [ "$DOC_FAIL" -eq 0 ] && [ "$DOC_WARN" -eq 0 ]; then
        printf '  Everything checks out. Try:  sts status\n'
    else
        printf '  %s problem(s), %s warning(s)' "$DOC_FAIL" "$DOC_WARN"
        [ "$DOC_FIXED" -gt 0 ] && printf ', %s fixed' "$DOC_FIXED"
        [ "$DOC_SKIP" -gt 0 ]  && printf ', %s check(s) skipped' "$DOC_SKIP"
        printf '\n'
        if [ "$OPT_FIX" -eq 0 ] && [ "$DOC_FIXABLE" -gt 0 ]; then
            printf '  %s of these can be repaired automatically:  sts doctor --fix\n' "$DOC_FIXABLE"
        elif [ "$OPT_FIX" -eq 0 ] && [ "$DOC_FAIL" -gt 0 ]; then
            printf '  None of these can be repaired automatically; follow the steps above.\n'
        fi
        printf '  Nothing above was changed except where it says "fixed".\n'
    fi
    printf '\n'

    log INFO doctor "fail=$DOC_FAIL warn=$DOC_WARN fixed=$DOC_FIXED skipped=$DOC_SKIP"
    [ "$DOC_FAIL" -eq 0 ]
}

# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------

cmd_status() {
    local lman hman lfp hfp lep hep state
    lman="$(manifest_local "$CFG_LOCAL_SAVE_PATH")"
    hman="$(manifest_hub)"
    assert_manifest_hashable "$lman" local
    assert_manifest_hashable "$hman" hub
    lfp="$(fingerprint_of_manifest "$lman")"
    hfp="$(fingerprint_of_manifest "$hman")"
    lep="$(newest_mtime_local "$CFG_LOCAL_SAVE_PATH")"
    hep="$(newest_mtime_hub)"
    state="$(state_read)"

    say "$PROG status"
    say ""
    say "  this machine : $(this_host_id)$([ "$IS_HUB" -eq 1 ] && printf ' (IS the hub)')"
    say "  tailscale    : Running, hub via ${HUB_ENDPOINT_KIND}${HUB_ENDPOINT:+ ($HUB_ENDPOINT)}"
    say ""
    describe_side "LOCAL  $CFG_LOCAL_SAVE_PATH" "$lman" "$lep"
    say "    fingerprint: $(printf '%s' "$lfp" | cut -c1-16)"
    say ""
    describe_side "HUB    $CFG_HUB_HOST:$CFG_HUB_PATH" "$hman" "$hep"
    say "    fingerprint: $(printf '%s' "$hfp" | cut -c1-16)"
    say ""

    if [ "$lfp" = "$hfp" ]; then
        say "  verdict      : in sync"
    elif [ "$hfp" = "empty" ]; then
        say "  verdict      : the hub is EMPTY - seed it with 'sts push --force=local'"
    elif [ "$lfp" = "empty" ]; then
        say "  verdict      : this machine is EMPTY - 'sts pull' would first-seed it"
    elif [ "$lep" -gt "$hep" ]; then
        say "  verdict      : LOCAL is newer by $((lep - hep))s"
    elif [ "$hep" -gt "$lep" ]; then
        say "  verdict      : HUB is newer by $((hep - lep))s"
    else
        say "  verdict      : differ, but timestamps are equal - trust the fingerprints"
    fi

    if [ "$state" = "FIRSTRUN" ]; then
        say "  last sync    : never recorded on this machine (first run)"
    else
        say "  last sync    : $(printf '%s' "$state" | cut -f1) at $(human_time "$(printf '%s' "$state" | cut -f2)")"
    fi

    local lockinfo
    lockinfo="$(hub_exec_args 'cat "$1/owner" 2>/dev/null | head -3 | tr "\n" " "' "$(hub_lock_path)" 2>/dev/null || true)"
    if [ -n "$lockinfo" ]; then
        say "  hub lock     : HELD by $lockinfo"
    else
        say "  hub lock     : free"
    fi

    local gp
    gp="$(pgrep -x "$CFG_GAME_PROCESS_NAME" 2>/dev/null | tr '\n' ' ' || true)"
    if [ -n "$gp" ]; then
        say "  game         : RUNNING (pid $gp) - push and pull will refuse"
    else
        say "  game         : not running"
    fi
    log INFO status "local=$(printf '%s' "$lfp" | cut -c1-12) hub=$(printf '%s' "$hfp" | cut -c1-12)"
}

# Shared decision used by both pull and push.
# Echoes one of: INSYNC HUB_EMPTY FIRST_SEED FIRSTRUN_CONFLICT
#                LOCAL_ONLY HUB_ONLY BOTH_CHANGED
decide() {
    local lfp="$1" hfp="$2" lcount="$3" hcount="$4" state="$5"

    if [ "$lfp" = "$hfp" ]; then printf 'INSYNC'; return 0; fi

    if [ "$state" = "FIRSTRUN" ]; then
        if [ "$hcount" -eq 0 ] && [ "$lcount" -gt 0 ]; then printf 'HUB_EMPTY';  return 0; fi
        if [ "$lcount" -eq 0 ] && [ "$hcount" -gt 0 ]; then printf 'FIRST_SEED'; return 0; fi
        printf 'FIRSTRUN_CONFLICT'; return 0
    fi

    local s_lfp s_hfp
    s_lfp="$(printf '%s' "$state" | cut -f3)"
    s_hfp="$(printf '%s' "$state" | cut -f4)"

    local lchanged=0 hchanged=0
    [ "$lfp" != "$s_lfp" ] && lchanged=1
    [ "$hfp" != "$s_hfp" ] && hchanged=1

    if [ "$lchanged" -eq 1 ] && [ "$hchanged" -eq 1 ]; then printf 'BOTH_CHANGED'; return 0; fi
    if [ "$lchanged" -eq 1 ]; then printf 'LOCAL_ONLY'; return 0; fi
    if [ "$hchanged" -eq 1 ]; then printf 'HUB_ONLY';   return 0; fi
    # Neither side changed since the last sync, yet they differ. The recorded
    # state is inconsistent with reality - usually a sync that was recorded
    # against a hub another machine changed in the same moment.
    printf 'DIVERGED_STATE'
}

# --dry-run prints the real rsync plan for BOTH directions and touches nothing.
cmd_dry_run_plan() {
    local src dst e
    e="$(rsync_excludes)"
    say "dry run - nothing will be written. Real rsync plans, both directions:"
    say ""

    say "  HUB -> LOCAL  (what 'sts pull' would do)"
    if [ "$IS_HUB" -eq 1 ]; then
        src="$CFG_HUB_PATH/"; dst="$CFG_LOCAL_SAVE_PATH/"
        say "    rsync -a --delete $e $src $dst"
        rsync -a -n -i --delete $e "$src" "$dst" 2>&1 | sed 's/^/      /' || true
    else
        src="$(ssh_target):$CFG_HUB_PATH/"; dst="$CFG_LOCAL_SAVE_PATH/"
        say "    rsync -a --delete $e -e 'ssh $(ssh_opts)' $src $dst"
        rsync -a -n -i --delete $e -e "ssh $(ssh_opts)" "$src" "$dst" 2>&1 | sed 's/^/      /' || true
    fi
    say ""

    say "  LOCAL -> HUB  (what 'sts push' would do)"
    if [ "$IS_HUB" -eq 1 ]; then
        src="$CFG_LOCAL_SAVE_PATH/"; dst="$CFG_HUB_PATH/"
        say "    rsync -a --delete $e $src $dst"
        rsync -a -n -i --delete $e "$src" "$dst" 2>&1 | sed 's/^/      /' || true
    else
        src="$CFG_LOCAL_SAVE_PATH/"; dst="$(ssh_target):$CFG_HUB_PATH/"
        say "    rsync -a --delete $e -e 'ssh $(ssh_opts)' $src $dst"
        rsync -a -n -i --delete $e -e "ssh $(ssh_opts)" "$src" "$dst" 2>&1 | sed 's/^/      /' || true
    fi
    say ""
    say "  In a real run each of these goes into a temp directory on the"
    say "  receiving side first, and the target is snapshotted before the swap."
    log INFO dry-run "printed both plans"
}

cmd_pull() {
    check_game_not_running
    # Lock BEFORE reading either side, so the verdict cannot be computed
    # against a hub that another machine is about to change.
    acquire_hub_lock
    check_clock_skew

    local lman hman lfp hfp lcount hcount lep hep state verdict
    lman="$(manifest_local "$CFG_LOCAL_SAVE_PATH")"; hman="$(manifest_hub)"
    assert_manifest_hashable "$lman" local
    assert_manifest_hashable "$hman" hub
    lfp="$(fingerprint_of_manifest "$lman")"; hfp="$(fingerprint_of_manifest "$hman")"
    lcount="$(printf '%s' "$lman" | grep -c . || true)"; lcount="${lcount:-0}"
    hcount="$(printf '%s' "$hman" | grep -c . || true)"; hcount="${hcount:-0}"
    lep="$(newest_mtime_local "$CFG_LOCAL_SAVE_PATH")"; hep="$(newest_mtime_hub)"
    state="$(state_read)"
    verdict="$(decide "$lfp" "$hfp" "$lcount" "$hcount" "$state")"
    log INFO pull "verdict=$verdict local=$lcount files hub=$hcount files force='${OPT_FORCE}'"

    # Never let an empty hub empty this machine. Not overridable: there is
    # no situation where copying nothing over real saves is what you meant.
    if [ "$hcount" -eq 0 ] && [ "$lcount" -gt 0 ]; then
        die $EX_HUB_EMPTY pull \
            "the hub has 0 files and this machine has $lcount - refusing to empty this machine. If the hub really should be the source of truth, seed it first with '$PROG push --force=local' from the machine that has the saves."
    fi

    case "$verdict" in
        INSYNC)
            say "already in sync - nothing to pull"
            state_write pull "$lfp" "$hfp"
            release_hub_lock
            return 0 ;;
        HUB_EMPTY)
            die $EX_HUB_EMPTY pull \
                "the hub is empty and this machine has $lcount files - there is nothing to pull. If these saves should become the source of truth, run: $PROG push" ;;
        FIRST_SEED)
            say "first seed: this machine has no saves, the hub has $hcount files"
            log WARN pull "FIRST SEED - local was empty, seeding from hub (not an ordinary pull)"
            ;;
        FIRSTRUN_CONFLICT)
            if [ "$OPT_FORCE" != "hub" ]; then
                conflict_report "first run on this machine, and BOTH sides already have saves. This is a conflict, not a fresh start." \
                    "$lman" "$hman" "$lep" "$hep"
                log ERROR pull "first-run conflict"
                exit $EX_CONFLICT_FIRSTRUN
            fi
            warn "--force=hub: overwriting this machine's $lcount files with the hub's $hcount" ;;
        DIVERGED_STATE)
            printf 'error: the recorded sync state is inconsistent with what is on disk.\n' >&2
            printf 'Neither side changed since the last recorded sync, yet they differ.\n' >&2
            printf 'That usually means a sync was recorded against a hub another machine\n' >&2
            printf 'changed at the same moment, or SYNC_EXCLUDE differs between machines.\n\n' >&2
            conflict_report "not deciding this for you." "$lman" "$hman" "$lep" "$hep"
            log ERROR pull "diverged state"
            exit $EX_CONFLICT ;;
        BOTH_CHANGED)
            if [ "$OPT_FORCE" != "hub" ]; then
                conflict_report "both sides changed since the last sync on this machine." \
                    "$lman" "$hman" "$lep" "$hep"
                log ERROR pull "both sides changed"
                exit $EX_CONFLICT
            fi
            warn "--force=hub: discarding local changes" ;;
        LOCAL_ONLY)
            if [ "$OPT_FORCE" != "hub" ]; then
                conflict_report "only THIS machine changed since the last sync - pulling would discard those changes." \
                    "$lman" "$hman" "$lep" "$hep"
                log ERROR pull "local-only changes, refusing to pull"
                exit $EX_CONFLICT
            fi
            warn "--force=hub: discarding local changes" ;;
        HUB_ONLY) ;;
    esac

    say "pulling $CFG_HUB_HOST:$CFG_HUB_PATH -> $CFG_LOCAL_SAVE_PATH"
    pull_hub_to_local "$CFG_LOCAL_SAVE_PATH"

    lman="$(manifest_local "$CFG_LOCAL_SAVE_PATH")"
    lfp="$(fingerprint_of_manifest "$lman")"
    hman="$(manifest_hub)"
    hfp="$(fingerprint_of_manifest "$hman")"
    state_write pull "$lfp" "$hfp"
    release_hub_lock
    say "pull complete - $(printf '%s' "$lman" | grep -c . || echo 0) files"
}

cmd_push() {
    check_game_not_running
    acquire_hub_lock
    check_clock_skew

    local lman hman lfp hfp lcount hcount lep hep state verdict
    lman="$(manifest_local "$CFG_LOCAL_SAVE_PATH")"; hman="$(manifest_hub)"
    assert_manifest_hashable "$lman" local
    assert_manifest_hashable "$hman" hub
    lfp="$(fingerprint_of_manifest "$lman")"; hfp="$(fingerprint_of_manifest "$hman")"
    lcount="$(printf '%s' "$lman" | grep -c . || true)"; lcount="${lcount:-0}"
    hcount="$(printf '%s' "$hman" | grep -c . || true)"; hcount="${hcount:-0}"
    lep="$(newest_mtime_local "$CFG_LOCAL_SAVE_PATH")"; hep="$(newest_mtime_hub)"
    state="$(state_read)"
    verdict="$(decide "$lfp" "$hfp" "$lcount" "$hcount" "$state")"
    log INFO push "verdict=$verdict local=$lcount files hub=$hcount files force='${OPT_FORCE}'"

    # An emptied hub is a seed situation regardless of the state file. It
    # used to report "only the HUB changed - pushing would discard those
    # changes", when there are no changes, only zero files.
    if [ "$hcount" -eq 0 ] && [ "$lcount" -gt 0 ] && [ "$OPT_FORCE" != "local" ]; then
        printf 'The hub at %s:%s is empty.\n' "$CFG_HUB_HOST" "$CFG_HUB_PATH" >&2
        printf 'This machine has %s files, newest %s.\n\n' "$lcount" "$(human_time "$lep")" >&2
        printf 'If the hub should have saves, something went wrong there - check it\n' >&2
        printf 'before overwriting. If this machine is the source of truth, run:\n' >&2
        printf '  %s push --force=local\n' "$PROG" >&2
        log ERROR push "hub empty, refusing to seed without --force=local"
        exit $EX_HUB_EMPTY
    fi

    # Symmetric guard: never let an empty local directory wipe the hub.
    if [ "$lcount" -eq 0 ] && [ "$hcount" -gt 0 ]; then
        die $EX_CONFLICT_FIRSTRUN push \
            "this machine has 0 files and the hub has $hcount - refusing to empty the hub. If this machine's empty state is correct, delete the hub contents by hand on $CFG_HUB_HOST."
    fi

    case "$verdict" in
        INSYNC)
            say "already in sync - nothing to push"
            state_write push "$lfp" "$hfp"
            release_hub_lock
            return 0 ;;
        HUB_EMPTY)
            # Never seed the hub silently.
            if [ "$OPT_FORCE" != "local" ]; then
                printf 'The hub at %s:%s is empty.\n' "$CFG_HUB_HOST" "$CFG_HUB_PATH" >&2
                printf 'This machine has %s files, newest %s.\n' "$lcount" "$(human_time "$lep")" >&2
                printf '\nSeeding the hub is a one-way decision, so it is not done silently.\n' >&2
                printf 'If these saves are the source of truth, run:\n' >&2
                printf '  %s push --force=local\n' "$PROG" >&2
                log ERROR push "hub empty, refusing to seed without --force=local"
                exit $EX_HUB_EMPTY
            fi
            say "seeding the empty hub with $lcount files from this machine" ;;
        FIRST_SEED)
            die $EX_CONFLICT_FIRSTRUN push \
                "this machine has no saves but the hub has $hcount files - pushing would wipe the hub. Run '$PROG pull' instead." ;;
        FIRSTRUN_CONFLICT)
            if [ "$OPT_FORCE" != "local" ]; then
                conflict_report "first run on this machine, and BOTH sides already have saves. This is a conflict, not a fresh start." \
                    "$lman" "$hman" "$lep" "$hep"
                log ERROR push "first-run conflict"
                exit $EX_CONFLICT_FIRSTRUN
            fi
            warn "--force=local: overwriting the hub's $hcount files with this machine's $lcount" ;;
        DIVERGED_STATE)
            printf 'error: the recorded sync state is inconsistent with what is on disk.\n' >&2
            printf 'Neither side changed since the last recorded sync, yet they differ.\n' >&2
            printf 'That usually means a sync was recorded against a hub another machine\n' >&2
            printf 'changed at the same moment, or SYNC_EXCLUDE differs between machines.\n\n' >&2
            conflict_report "not deciding this for you." "$lman" "$hman" "$lep" "$hep"
            log ERROR push "diverged state"
            exit $EX_CONFLICT ;;
        BOTH_CHANGED)
            if [ "$OPT_FORCE" != "local" ]; then
                conflict_report "both sides changed since the last sync on this machine." \
                    "$lman" "$hman" "$lep" "$hep"
                log ERROR push "both sides changed"
                exit $EX_CONFLICT
            fi
            warn "--force=local: discarding hub changes" ;;
        HUB_ONLY)
            if [ "$OPT_FORCE" != "local" ]; then
                conflict_report "only the HUB changed since the last sync - pushing would discard those changes." \
                    "$lman" "$hman" "$lep" "$hep"
                log ERROR push "hub-only changes, refusing to push"
                exit $EX_CONFLICT
            fi
            warn "--force=local: discarding hub changes" ;;
        LOCAL_ONLY) ;;
    esac

    # The hub directory may legitimately not exist yet on a first seed.
    hub_exec_args 'mkdir -p "$1"' "$CFG_HUB_PATH" >/dev/null 2>&1 || true
    say "pushing $CFG_LOCAL_SAVE_PATH -> $CFG_HUB_HOST:$CFG_HUB_PATH"
    push_local_to_hub "$CFG_LOCAL_SAVE_PATH"

    hman="$(manifest_hub)"
    hfp="$(fingerprint_of_manifest "$hman")"
    state_write push "$lfp" "$hfp"
    release_hub_lock
    say "push complete - $(printf '%s' "$hman" | grep -c . || echo 0) files on the hub"
}

# --------------------------------------------------------------------------
# sts play - pull, launch, wait, push. The hub lock is NOT held while you
# play; pull and push each take and release it around their own transfer.
# --------------------------------------------------------------------------

cmd_play() {
    check_game_not_running

    if [ "$HUB_ENDPOINT_KIND" = "offline" ]; then
        warn "======================================================================"
        warn "THE HUB IS OFFLINE AND --offline-ok WAS GIVEN."
        warn "Nothing was pulled. You are about to play on this machine's local"
        warn "save, which may be older than the hub's. Nothing will be pushed"
        warn "afterwards either. Sync by hand once the hub is reachable."
        warn "======================================================================"
        log WARN play "playing offline, no pull, no push"
    else
        say "pulling before launch..."
        cmd_pull
    fi

    local start_epoch
    start_epoch="$(date -u +%s)"

    say "launching Star Traders: Frontiers (appid $CFG_STEAM_APPID)..."
    log INFO play "open steam://rungameid/$CFG_STEAM_APPID"
    if ! open "steam://rungameid/$CFG_STEAM_APPID" 2>/dev/null; then
        die $EX_GAME_NO_START play \
            "'open steam://rungameid/$CFG_STEAM_APPID' failed - is Steam installed?"
    fi

    # Wait for the process to appear. If it never does, the game did not
    # start, and pushing an unchanged save would be a lie.
    local waited=0 pid=""
    while :; do
        pid="$(pgrep -x "$CFG_GAME_PROCESS_NAME" 2>/dev/null | head -1 || true)"
        [ -n "$pid" ] && break
        [ "$waited" -ge "$CFG_GAME_START_TIMEOUT" ] && break
        sleep 2
        waited=$((waited + 2))
    done

    if [ -z "$pid" ]; then
        log ERROR play "process '$CFG_GAME_PROCESS_NAME' never appeared within ${CFG_GAME_START_TIMEOUT}s"
        printf 'error: the game never started.\n' >&2
        printf 'Waited %ss for a process named %s and saw nothing.\n' \
            "$CFG_GAME_START_TIMEOUT" "$CFG_GAME_PROCESS_NAME" >&2
        printf 'Nothing was pushed - an unchanged save is not worth recording.\n' >&2
        printf 'Check that STEAM_APPID=%s is right and Steam is installed:\n' "$CFG_STEAM_APPID" >&2
        printf '  open steam://rungameid/%s\n' "$CFG_STEAM_APPID" >&2
        printf '  pgrep -x %s\n' "$CFG_GAME_PROCESS_NAME" >&2
        exit $EX_GAME_NO_START
    fi

    say "game running (pid $pid) - waiting for it to exit. Ctrl-C here does not stop the game."
    log INFO play "game started, pid $pid"

    local gone=0
    while :; do
        if pgrep -x "$CFG_GAME_PROCESS_NAME" >/dev/null 2>&1; then
            gone=0
        else
            gone=$((gone + 1))
            # Steam sometimes re-execs the game; require it to stay gone.
            [ "$gone" -ge 3 ] && break
        fi
        sleep 5
    done

    # Distinguish a clean quit from a crash by looking for a crash report
    # written after we launched. Either way the save still gets pushed.
    # ReportCrash writes the .ips after the process is reaped, so give it a
    # moment rather than racing it.
    sleep 5
    local crash="" report mtime
    for report in "$HOME/Library/Logs/DiagnosticReports/$CFG_GAME_PROCESS_NAME"*; do
        [ -f "$report" ] || continue
        mtime="$(stat -f%m "$report" 2>/dev/null || echo 0)"
        if [ "$mtime" -ge "$start_epoch" ]; then crash="$report"; break; fi
    done
    if [ -n "$crash" ]; then
        log WARN play "game exited via CRASH - report at $crash"
        warn "the game crashed (report: $crash) - pushing the save anyway"
    else
        log INFO play "game exited cleanly (pid $pid gone, no crash report)"
        say "game exited."
    fi

    if [ "$HUB_ENDPOINT_KIND" = "offline" ]; then
        warn "hub still offline - NOT pushing. Run '$PROG push' when it is back."
        return 0
    fi

    say "pushing after play..."
    cmd_push
}

# --------------------------------------------------------------------------
# sts backup - hub host only, hub -> external disk, timestamped.
# This is purely local to the hub, so it deliberately does not require the
# tailnet: hub identity is decided by hostname here, and that is logged.
# --------------------------------------------------------------------------

is_hub_by_hostname() {
    local want h1 h2
    want="$(printf '%s' "$CFG_HUB_HOST" | tr '[:upper:]' '[:lower:]')"
    h1="$(hostname -s | tr '[:upper:]' '[:lower:]')"
    h2="$(scutil --get LocalHostName 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
    [ "$want" = "$h1" ] || [ "$want" = "$h2" ]
}

# An unmounted volume leaves an empty directory at the mount point on the
# internal disk. Comparing device ids catches that; checking -d does not.
# Returns 0 when the volume is genuinely mounted, 1 when it is not.
backup_volume_mounted() {
    local vol="$CFG_BACKUP_VOLUME" dev_vol dev_parent
    [ -d "$vol" ] || return 1
    dev_vol="$(stat -f%d "$vol" 2>/dev/null || echo x)"
    dev_parent="$(stat -f%d "$(dirname "$vol")" 2>/dev/null || echo y)"
    [ "$dev_vol" != "$dev_parent" ] || return 1
    [ -w "$vol" ] || return 1
    return 0
}

check_backup_volume() {
    local vol="$CFG_BACKUP_VOLUME" dev_vol dev_parent waited

    # A scheduled backup can fire moments after wake, before an external
    # disk has remounted. Failing instantly would lose the whole day's
    # backup over a condition that resolves itself in seconds.
    if [ "$CFG_BACKUP_MOUNT_WAIT" -gt 0 ] && ! backup_volume_mounted; then
        say "waiting up to ${CFG_BACKUP_MOUNT_WAIT}s for $vol to mount..."
        log INFO backup "waiting up to ${CFG_BACKUP_MOUNT_WAIT}s for $vol"
        waited=0
        while [ "$waited" -lt "$CFG_BACKUP_MOUNT_WAIT" ]; do
            sleep 5
            waited=$((waited + 5))
            if backup_volume_mounted; then
                log INFO backup "$vol appeared after ${waited}s"
                break
            fi
        done
    fi

    [ -d "$vol" ] || die $EX_BACKUP_NOT_MOUNTED backup \
        "backup volume $vol is not present at all - is the disk plugged in?"

    dev_vol="$(stat -f%d "$vol" 2>/dev/null || echo x)"
    dev_parent="$(stat -f%d "$(dirname "$vol")" 2>/dev/null || echo y)"
    if [ "$dev_vol" = "$dev_parent" ]; then
        die $EX_BACKUP_NOT_MOUNTED backup \
            "$vol exists but is NOT a mount point - it is a plain directory on the internal disk (device $dev_vol, same as $(dirname "$vol")). Refusing to write backups there. Mount the disk and re-run."
    fi
    [ -w "$vol" ] || die $EX_BACKUP_NOT_MOUNTED backup \
        "$vol is mounted but not writable - is it mounted read-only?"
    log DEBUG backup "volume $vol mounted, device $dev_vol"
}

# Lists timestamp-shaped backup directories that carry a completion marker,
# oldest first. Anything else is an interrupted or foreign directory and is
# neither used as a --link-dest base nor counted for retention.
list_complete_backups() {
    local cand
    [ -d "$CFG_BACKUP_DEST" ] || return 0
    ls -1 "$CFG_BACKUP_DEST" 2>/dev/null | LC_ALL=C sort | while IFS= read -r cand
    do
        case "$cand" in
            20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]T*) ;;
            *) continue ;;
        esac
        if [ -f "$CFG_BACKUP_DEST/$cand/.sts-complete" ]; then
            printf '%s\n' "$cand"
        fi
    done
    return 0
}

cmd_backup() {
    if ! is_hub_by_hostname; then
        die $EX_BACKUP_NOT_HUB backup \
            "'$PROG backup' only runs on the hub host ($CFG_HUB_HOST). This machine is $(hostname -s)."
    fi
    log INFO backup "hub identity confirmed by hostname: $(hostname -s)"

    # The hub is local to us by definition here, so hub_exec stays local and
    # no tailnet is needed. Taking the hub lock is what stops the other
    # machine swapping HUB_PATH out from under our rsync mid-traversal - a
    # torn backup used to join the rotation looking exactly like a good one.
    IS_HUB=1
    HUB_ENDPOINT_KIND="local"
    acquire_hub_lock

    check_backup_volume

    [ -d "$CFG_HUB_PATH" ] || die $EX_HUB_PATH_MISSING backup \
        "hub path $CFG_HUB_PATH does not exist on this machine"

    # Never back up an empty hub over a good rotation. Without this, an
    # emptied hub backed up nightly ages every real backup out within
    # BACKUP_KEEP days - the backups are the last line of defence.
    local src_n
    src_n="$(find "$CFG_HUB_PATH" -type f ! -name "$LOCK_DIRNAME" 2>/dev/null | grep -c . || true)"
    src_n="${src_n:-0}"
    if [ "$src_n" -eq 0 ]; then
        die $EX_HUB_EMPTY backup \
            "the hub at $CFG_HUB_PATH has 0 files - refusing to back up an empty hub over the existing rotation. Investigate the hub before running this again."
    fi

    if [ "$OPT_DRY_RUN" -eq 1 ]; then
        say "dry run - would back up $CFG_HUB_PATH ($src_n files) into $CFG_BACKUP_DEST"
        rsync -a -n -i "$CFG_HUB_PATH/" "$CFG_BACKUP_DEST/pending/" 2>&1 | sed 's/^/  /' || true
        release_hub_lock
        return 0
    fi

    mkdir -p "$CFG_BACKUP_DEST" || die $EX_BACKUP_NOT_MOUNTED backup \
        "could not create $CFG_BACKUP_DEST"

    # Only a directory carrying the completion marker counts as a real
    # backup, for --link-dest and for retention.
    local prev
    prev="$(list_complete_backups | tail -1)"

    local can_link=1 lt_a lt_b
    lt_a="$CFG_BACKUP_DEST/.sts-linktest"
    lt_b="$CFG_BACKUP_DEST/.sts-linktest-2"
    rm -f "$lt_a" "$lt_b" 2>/dev/null || true
    if : > "$lt_a" 2>/dev/null && ln "$lt_a" "$lt_b" 2>/dev/null; then
        can_link=1
    else
        can_link=0
    fi
    rm -f "$lt_a" "$lt_b" 2>/dev/null || true
    if [ "$can_link" -eq 0 ]; then
        log INFO backup "$CFG_BACKUP_DEST does not support hard links (exFAT or similar) - each backup is a full copy"
    fi

    local stamp dest suffix mkerr
    stamp="$(iso_now)"
    dest="$CFG_BACKUP_DEST/$stamp"
    suffix=2
    mkerr=""
    while :; do
        mkerr="$(mkdir "$dest" 2>&1)" && break
        # A name collision is expected within the same second; anything else
        # is a real error and repeating it 50 times only hides it.
        case "$mkerr" in
            *"File exists"*) ;;
            *)
                log ERROR backup "mkdir $dest failed: $mkerr"
                printf 'error: could not create the backup directory.\n' >&2
                printf '  %s\n' "$mkerr" >&2
                printf '\nThe volume is mounted and writable, so this is usually macOS\n' >&2
                printf 'privacy protection: a launchd job needs explicit permission to\n' >&2
                printf 'write to a removable volume, and is denied silently without a\n' >&2
                printf 'prompt. Grant it in System Settings > Privacy & Security >\n' >&2
                printf 'Full Disk Access, for /bin/bash.\n' >&2
                exit $EX_BACKUP_NOT_MOUNTED ;;
        esac
        dest="$CFG_BACKUP_DEST/$stamp-$suffix"
        suffix=$((suffix + 1))
        if [ "$suffix" -gt 50 ]; then
            die $EX_BACKUP_NOT_MOUNTED backup \
                "could not create a unique backup directory under $CFG_BACKUP_DEST after 50 attempts"
        fi
    done

    say "backing up $CFG_HUB_PATH ($src_n files) -> $dest"
    BACKUP_PENDING="$dest"
    if [ -n "$prev" ] && [ "$can_link" -eq 1 ]; then
        run_rsync backup -a --link-dest="$CFG_BACKUP_DEST/$prev" \
            "$CFG_HUB_PATH/" "$dest/" >/dev/null
        log INFO backup "hardlinked unchanged files against $prev"
    else
        run_rsync backup -a "$CFG_HUB_PATH/" "$dest/" >/dev/null
    fi

    local dst_n
    dst_n="$(find "$dest" -type f 2>/dev/null | grep -c . || true)"
    dst_n="${dst_n:-0}"
    if [ "$dst_n" -lt "$src_n" ]; then
        rm -rf "$dest"
        die $EX_RSYNC backup \
            "backup is INCOMPLETE - $src_n files in the hub, only $dst_n copied. The partial copy was removed so it cannot be mistaken for a good backup."
    fi

    # The marker is written last. Anything without it was interrupted.
    date -u +%Y-%m-%dT%H:%M:%SZ > "$dest/.sts-complete"
    BACKUP_PENDING=""

    # Prune only timestamp-shaped, completed backups, newest kept.
    if [ "$CFG_BACKUP_KEEP" -gt 0 ]; then
        local completed n old
        completed="$(list_complete_backups)"
        n="$(printf '%s\n' "$completed" | grep -c . || true)"
        if [ "${n:-0}" -gt "$CFG_BACKUP_KEEP" ]; then
            printf '%s\n' "$completed" | head -n $((n - CFG_BACKUP_KEEP)) | while IFS= read -r old
            do
                if [ -n "$old" ]; then
                    rm -rf "${CFG_BACKUP_DEST:?}/$old"
                    log INFO backup "pruned old backup $old"
                fi
            done
        fi
    fi

    release_hub_lock
    say "backup complete: $dest ($dst_n files)"
    log INFO backup "complete $dest ($dst_n files)"
}

# --------------------------------------------------------------------------
# Usage
# --------------------------------------------------------------------------

usage() {
cat <<USAGE_EOF
$PROG $STS_VERSION - sync Star Traders: Frontiers saves between Macs

USAGE
  $PROG <command> [flags]
  sts <command> [flags]

COMMANDS
  doctor    check every prerequisite on this machine and say exactly how to
            fix each problem. Read-only unless --fix is given. Run this first
            on a new machine, and whenever something is not working.
  status    read-only. Local and hub file counts, newest timestamps,
            fingerprints, which side is newer, hub lock state, tailscale
            state and whether the game is running. Changes nothing.
  pull      hub -> this machine. Run before playing.
  push      this machine -> hub. Run after playing.
  play      pull, launch the game, wait for it to exit, then push.
  backup    hub -> external disk, timestamped. Hub host only.

FLAGS
  --dry-run        print the real rsync plan for BOTH directions and exit.
                   Touches nothing on either side.
  --verbose        mirror the log to stderr as well as the log file.
  --force=local    resolve a conflict by keeping THIS machine's saves.
  --force=hub      resolve a conflict by keeping the HUB's saves.
                   Neither --force can make sts sync FROM an empty side;
                   that is refused unconditionally.
  --offline-ok     if the hub is offline, allow 'play' to run on the local
                   save. Warns loudly. Nothing is synced in either direction.
  --fix            with 'doctor', apply the repairs that are safe, reversible
                   and idempotent. Never accepts a host key, changes system
                   settings, or grants permissions - those it explains.
  -h, --help       this text.
  --version        print version and exit.

FILES
  config   ${CONFIG_FILE}
  state    ${STATE_FILE}
  log      ${LOG_FILE}  (rotates at LOG_MAX_BYTES, keeps LOG_KEEP)

EXIT CODES
  0   success
  2   usage error

  Config and environment
  10  config file missing or unreadable
  11  config malformed: unparseable line, or an unknown key
  12  required config keys missing or empty (all listed at once)
  13  LOCAL_SAVE_PATH missing/not a directory, or a previous run was
      interrupted mid-swap and the saves need restoring by hand
  14  hub path does not exist on the hub host
  15  running as root (refused)
  16  bash older than 3.2 (refused)
  17  rsync, ssh or python3 not on PATH

  Tailscale
  20  tailscale binary not found in /Applications or on PATH
  21  tailscaled not running
  22  node logged out or Stopped, still down after one 'tailscale up'
  23  tailscale needs an interactive login or reauth (URL printed)
  24  hub host not present in the tailnet at all
  25  hub host present but offline (use --offline-ok to play anyway)
  26  hub online but 'tailscale ping' failed or timed out

  SSH and transport
  30  non-interactive ssh failed (reproduction command printed)
  31  ssh host key unknown or changed (never auto-accepted)
  32  hub user cannot read or write the hub directory
  33  rsync exited non-zero (its own code and stderr are printed)
  34  out of disk space on one side
  63  snapshot failed or was incomplete, so nothing was overwritten

  Game and concurrency
  40  the game is running on this machine
  41  the game never started (wrong appid, or Steam missing)
  50  hub lock held by another machine
  51  hub lock could not be created
  52  another $PROG is already running on this machine

  Data safety
  60  both sides changed since the last sync - resolve with --force=
  61  first run with saves on both sides, OR this machine is empty and
      pushing would wipe the hub (refused, not overridable)
  62  hub is empty; seeding needs 'push --force=local', OR the hub is
      empty and pulling would wipe this machine (refused, not overridable)

  Backup
  70  backup volume not mounted (or not actually a mount point)
  71  'backup' run on a machine that is not the hub host

Full troubleshooting table: README.md
USAGE_EOF
}

# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            status|pull|push|play|backup|doctor)
                [ -n "$COMMAND" ] && { printf 'error: more than one command given: %s and %s\n' "$COMMAND" "$1" >&2; exit $EX_USAGE; }
                COMMAND="$1" ;;
            --dry-run)    OPT_DRY_RUN=1 ;;
            --verbose|-v) OPT_VERBOSE=1 ;;
            --offline-ok) OPT_OFFLINE_OK=1 ;;
            --fix)        OPT_FIX=1 ;;
            --force=local) OPT_FORCE="local" ;;
            --force=hub)   OPT_FORCE="hub" ;;
            --force=*)
                printf 'error: --force takes exactly "local" or "hub", got "%s"\n' "${1#--force=}" >&2
                exit $EX_USAGE ;;
            --force)
                printf 'error: --force needs a value: --force=local or --force=hub\n' >&2
                exit $EX_USAGE ;;
            -h|--help)    usage; exit $EX_OK ;;
            --version)    printf '%s %s\n' "$PROG" "$STS_VERSION"; exit $EX_OK ;;
            *)
                printf 'error: unknown argument "%s"\n' "$1" >&2
                printf "run '%s --help'\n" "$PROG" >&2
                exit $EX_USAGE ;;
        esac
        shift
    done
    [ -n "$COMMAND" ] || { usage >&2; exit $EX_USAGE; }

    # Reject an impossible direction up front, not after the hub lock is
    # taken - and, for play, not after the game session has already ended.
    case "$COMMAND:$OPT_FORCE" in
        pull:local)
            printf 'error: --force=local makes no sense for "pull" - it would discard the hub.\n' >&2
            printf 'Use:  %s push --force=local\n' "$PROG" >&2
            exit $EX_USAGE ;;
        push:hub)
            printf 'error: --force=hub makes no sense for "push" - it would discard this machine.\n' >&2
            printf 'Use:  %s pull --force=hub\n' "$PROG" >&2
            exit $EX_USAGE ;;
        *) ;;
    esac
    if [ "$OPT_FIX" -eq 1 ] && [ "$COMMAND" != "doctor" ]; then
        printf 'error: --fix only applies to "doctor".\n' >&2
        printf 'Use:  %s doctor --fix\n' "$PROG" >&2
        exit $EX_USAGE
    fi
    case "$COMMAND:$OPT_FORCE" in
        play:local|play:hub)
            printf 'error: --force cannot be used with "play", which pulls before and pushes after.\n' >&2
            printf 'Resolve the conflict explicitly first, then play:\n' >&2
            printf '  %s pull --force=hub     keep the hub'"'"'s saves\n' "$PROG" >&2
            printf '  %s push --force=local   keep this machine'"'"'s saves\n' "$PROG" >&2
            exit $EX_USAGE ;;
    esac
}

main() {
    parse_args "$@"

    # doctor runs before every other check, because the things those checks
    # abort on are exactly what it exists to report.
    if [ "$COMMAND" = "doctor" ]; then
        cmd_doctor
        exit $?
    fi

    # Cheapest, most fundamental refusals first - these need no config.
    check_not_root
    check_bash_version
    check_tools

    load_config
    validate_config

    log INFO start "command=$COMMAND dry_run=$OPT_DRY_RUN force='${OPT_FORCE}' offline_ok=$OPT_OFFLINE_OK version=$STS_VERSION"

    HUB_LOCK_NONCE="$(this_host_id)-$$-$(date -u +%s)"

    acquire_local_lock
    if [ "$COMMAND" != "backup" ]; then
        # Only after the local lock: the sweep deletes staging directories,
        # and before the lock it could delete a running sync's own.
        case "$COMMAND" in
            status) recover_orphans check ;;   # report only, never delete
            *)      recover_orphans sweep ;;
        esac
        check_local_save_path
    fi

    # backup is local to the hub and deliberately does not need the tailnet.
    if [ "$COMMAND" = "backup" ]; then
        cmd_backup
        exit $EX_OK
    fi

    find_tailscale
    detect_self_is_hub
    if [ "$IS_HUB" -eq 0 ]; then
        resolve_hub_endpoint
        if [ "$HUB_ENDPOINT_KIND" != "offline" ]; then
            check_hub_reachable
        fi
    fi

    # --offline-ok only means anything for 'play'. For everything else the
    # hub is the whole point, so say that instead of ssh-ing to nothing.
    if [ "$HUB_ENDPOINT_KIND" = "offline" ] && [ "$COMMAND" != "play" ]; then
        die $EX_TS_PEER_OFFLINE hub \
            "--offline-ok only applies to '$PROG play'; '$COMMAND' needs the hub, and $CFG_HUB_HOST is offline"
    fi

    if [ "$OPT_DRY_RUN" -eq 1 ]; then
        cmd_dry_run_plan
        exit $EX_OK
    fi

    # The hub directory must exist for everything except a first push, which
    # is allowed to create it after an explicit --force=local.
    # push runs it too, so an interrupted hub swap is caught before the seed
    # path can quietly abandon the parked copy. Only 'missing' is tolerated.
    if [ "$HUB_ENDPOINT_KIND" != "offline" ]; then
        if [ "$COMMAND" = "push" ]; then
            check_hub_path yes
        else
            check_hub_path no
        fi
    fi

    case "$COMMAND" in
        status) cmd_status ;;
        pull)   cmd_pull ;;
        push)   cmd_push ;;
        play)   cmd_play ;;
    esac

    exit $EX_OK
}

main "$@"
